---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Abogados Penales Pichilemu | Litigio Estratégico VI Región"
  description="Litigio estratégico en materia penal en Pichilemu y toda la VI Región. Estándar de Santiago, atención local. Compliance, querellas, defensa penal."
>
  <Header />

  <main class="pt-20">
    <!-- Hero Pichilemu Penal -->
    <section class="relative py-24 bg-primary">
      <div class="max-w-6xl mx-auto px-4">
        <div class="max-w-3xl" data-aos="fade-up">
          <p class="text-accent font-medium tracking-widest uppercase mb-4 text-sm">
            VI Región de O'Higgins
          </p>
          <h1 class="text-5xl md:text-6xl font-light text-white mb-6">
            Litigio Estratégico Penal<br>
            <span class="text-accent">Pichilemu y VI Región</span>
          </h1>
          <p class="text-xl text-white/80 leading-relaxed mb-8">
            Estudio jurídico con estándar de Santiago. Litigio estratégico en materia penal: compliance, querellas criminales, defensa penal económico. Atención en toda la Región Metropolitana y VI Región de O'Higgins.
          </p>
          <a href="https://wa.me/56985497497" class="inline-block bg-[#25D366] text-white px-8 py-4 font-medium tracking-widest uppercase text-sm hover:bg-[#1da851] transition-all duration-300">
            Consulta Penal Inmediata
          </a>
        </div>
      </div>
    </section>

    <!-- Servicios Penales -->
    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-12" data-aos="fade-up">
          <h2 class="text-3xl md:text-4xl font-semibold text-primary mb-4">
            Especialidades Penales
          </h2>
          <p class="text-text-light max-w-2xl mx-auto">
            Litigio estratégico en materia penal con estándar de Santiago.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="bg-bg-light p-8 text-center" data-aos="fade-up" data-aos-delay="0">
            <div class="w-16 h-16 bg-primary text-white flex items-center justify-center mx-auto mb-6 text-2xl font-light">Ⅰ</div>
            <h3 class="text-xl font-bold text-primary mb-4">Compliance Penal</h3>
            <p class="text-text-light">
              Prevención de riesgos penales para empresas. Programas de cumplimiento normativo, debida diligencia, capacitación.
            </p>
          </div>

          <div class="bg-bg-light p-8 text-center" data-aos="fade-up" data-aos-delay="100">
            <div class="w-16 h-16 bg-primary text-white flex items-center justify-center mx-auto mb-6 text-2xl font-light">Ⅱ</div>
            <h3 class="text-xl font-bold text-primary mb-4">Querellas Criminales</h3>
            <p class="text-text-light">
              Presentación de querellas estratégicas. Representación de víctimas. Investigación y acumulación de prueba.
            </p>
          </div>

          <div class="bg-bg-light p-8 text-center" data-aos="fade-up" data-aos-delay="200">
            <div class="w-16 h-16 bg-primary text-white flex items-center justify-center mx-auto mb-6 text-2xl font-light">Ⅲ</div>
            <h3 class="text-xl font-bold text-primary mb-4">Defensa Penal</h3>
            <p class="text-text-light">
              Defensa en delitos económicos, fraude corporativo, delitos contra la probidad pública. Estrategia procesal.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Cobertura -->
    <section class="py-16 bg-bg-light">
      <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-12" data-aos="fade-up">
          <h2 class="text-3xl md:text-4xl font-semibold text-primary mb-4">
            Cobertura Regional
          </h2>
          <p class="text-text-light max-w-2xl mx-auto">
            Atendemos toda la VI Región de O'Higgins y Región Metropolitana.
          </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4" data-aos="fade-up" data-aos-delay="100">
          <div class="bg-white p-4 text-center">
            <div class="font-semibold text-primary">Pichilemu</div>
            <div class="text-sm text-text-light">Costa</div>
          </div>
          <div class="bg-white p-4 text-center">
            <div class="font-semibold text-primary">Rancagua</div>
            <div class="text-sm text-text-light">Valle</div>
          </div>
          <div class="bg-white p-4 text-center">
            <div class="font-semibold text-primary">San Fernando</div>
            <div class="text-sm text-text-light">Valle</div>
          </div>
          <div class="bg-white p-4 text-center">
            <div class="font-semibold text-primary">Santiago</div>
            <div class="text-sm text-text-light">Región Metropolitana</div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-primary">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-3xl md:text-4xl font-light text-white mb-6" data-aos="fade-up">
          Consulta Penal Inmediata
        </h2>
        <p class="text-white/80 mb-8" data-aos="fade-up" data-aos-delay="100">
          Litigio estratégico en materia penal. Estándar de Santiago, atención en toda la VI Región.
        </p>
        <div class="flex flex-wrap justify-center gap-4" data-aos="fade-up" data-aos-delay="200">
          <a href="https://wa.me/56985497497" class="inline-block bg-[#25D366] text-white px-8 py-4 font-medium tracking-widest uppercase text-sm hover:bg-[#1da851] transition-all duration-300">
            WhatsApp Directo
          </a>
          <a href="tel:+56985497497" class="inline-block bg-white text-primary px-8 py-4 font-medium tracking-widest uppercase text-sm hover:bg-gray-100 transition-all duration-300">
            Llamar Ahora
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
