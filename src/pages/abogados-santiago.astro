---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Abogados en Providencia, Santiago | RP Abogados - Litigación de Alta Complejidad"
  description="Estudio jurídico en Providencia, Santiago. Litigación civil, penal, contencioso administrativo y laboral. Oficina en Eliodoro Yáñez 2084, Providencia."
>
  <Header />

  <main class="pt-20">
    <!-- Hero Santiago -->
    <section class="relative py-24 bg-primary">
      <div class="max-w-6xl mx-auto px-4">
        <div class="max-w-3xl" data-aos="fade-up">
          <p class="text-accent font-medium tracking-widest uppercase mb-4 text-sm">
            Región Metropolitana
          </p>
          <h1 class="text-5xl md:text-6xl font-light text-white mb-6">
            Abogados en Providencia,<br>
            <span class="text-accent">Santiago</span>
          </h1>
          <p class="text-xl text-white/80 leading-relaxed mb-8">
            Estudio jurídico boutique en el corazón de Providencia. Litigación de alta complejidad con conducción directa de nuestros socios en Santiago y la Región Metropolitana.
          </p>
          <a href="#contacto" class="inline-block bg-[#25D366] text-white px-8 py-4 font-medium tracking-widest uppercase text-sm hover:bg-[#1da851] transition-all duration-300">
            Consulta en Santiago
          </a>
        </div>
      </div>
    </section>

    <!-- Ubicación -->
    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-4">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div data-aos="fade-right">
            <h2 class="text-3xl md:text-4xl font-semibold text-primary mb-6">
              Nuestra oficina en Providencia
            </h2>
            <div class="space-y-4 text-text-light">
              <p class="flex items-start gap-3">
                <span class="text-accent mt-1">📍</span>
                <span><strong class="text-primary">Dirección:</strong> Eliodoro Yáñez 2084, oficina 41, Providencia, Santiago</span>
              </p>
              <p class="flex items-start gap-3">
                <span class="text-accent mt-1">🚇</span>
                <span><strong class="text-primary">Metro:</strong> Línea 5, estación Parque Bustamante (a 5 minutos)</span>
              </p>
              <p class="flex items-start gap-3">
                <span class="text-accent mt-1">🅿️</span>
                <span><strong class="text-primary">Estacionamiento:</strong> Disponible en el edificio</span>
              </p>
              <p class="flex items-start gap-3">
                <span class="text-accent mt-1">🕐</span>
                <span><strong class="text-primary">Horarios:</strong> Lunes a Viernes, 9:00 - 18:00 hrs</span>
              </p>
            </div>
          </div>
          <div class="bg-bg-light p-8" data-aos="fade-left">
            <h3 class="text-xl font-semibold text-primary mb-4">Áreas de práctica en Santiago</h3>
            <ul class="space-y-3 text-text-light">
              <li>• Litigación Civil y Controversias Patrimoniales</li>
              <li>• Litigación Penal y Delitos Económicos</li>
              <li>• Derecho Público y Contencioso Administrativo</li>
              <li>• Litigación Laboral de Alta Cuantía</li>
            </ul>
            <div class="mt-6 pt-6 border-t border-gray-200">
              <p class="text-sm text-text-light">
                <strong class="text-primary">Cobertura:</strong> Providencia, Las Condes, Vitacura, Santiago Centro, Ñuñoa, La Reina y toda la Región Metropolitana.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Mapa -->
    <section class="py-16 bg-bg-light">
      <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-12" data-aos="fade-up">
          <h2 class="text-3xl md:text-4xl font-semibold text-primary mb-4">Cómo llegar</h2>
          <p class="text-text-light max-w-2xl mx-auto">
            Estamos ubicados en una zona estratégica de Providencia, con fácil acceso desde toda la RM.
          </p>
        </div>
        <div class="rounded-lg overflow-hidden shadow-lg" data-aos="fade-up" data-aos-delay="100">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3329.1234567890123!2d-70.6166!3d-33.4263!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9662c50b12345678%3A0x1234567890abcdef!2sEliodoro%20Y%C3%A1%C3%B1ez%202084%2C%20Providencia%2C%20Santiago!5e0!3m2!1ses!2scl!4v1234567890123!5m2!1ses!2scl" 
            width="100%" 
            height="400" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            title="RP Abogados - Eliodoro Yáñez 2084, Providencia, Santiago">
          </iframe>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section id="contacto" class="py-16 bg-primary">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-3xl md:text-4xl font-light text-white mb-6" data-aos="fade-up">
          Consulta en Santiago
        </h2>
        <p class="text-white/80 mb-8" data-aos="fade-up" data-aos-delay="100">
          Agenda tu consulta presencial en nuestra oficina de Providencia o telemática.
        </p>
        <div class="flex flex-wrap justify-center gap-4" data-aos="fade-up" data-aos-delay="200">
          <a href="https://wa.me/56985497497" class="inline-block bg-[#25D366] text-white px-8 py-4 font-medium tracking-widest uppercase text-sm hover:bg-[#1da851] transition-all duration-300">
            WhatsApp Directo
          </a>
          <a href="tel:+56985497497" class="inline-block bg-white text-primary px-8 py-4 font-medium tracking-widest uppercase text-sm hover:bg-gray-100 transition-all duration-300">
            Llamar Ahora
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
