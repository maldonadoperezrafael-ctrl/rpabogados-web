---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Abogados Provincia de Cardenal Caro | Pichilemu, Marchihue, Litueche, Navidad"
  description="Litigio estratégico penal en toda la Provincia de Cardenal Caro. Pichilemu, Marchihue, Litueche, La Estrella, Navidad, Paredones. Estándar de Santiago."
>
  <Header />

  <main class="pt-20">
    <!-- Hero Provincia Cardenal Caro -->
    <section class="relative py-24 bg-primary">
      <div class="max-w-6xl mx-auto px-4">
        <div class="max-w-3xl" data-aos="fade-up">
          <p class="text-accent font-medium tracking-widest uppercase mb-4 text-sm">
            Provincia de Cardenal Caro
          </p>
          <h1 class="text-5xl md:text-6xl font-light text-white mb-6">
            Abogados en Cardenal Caro<br>
            <span class="text-accent">Litigio Estratégico Penal</span>
          </h1>
          <p class="text-xl text-white/80 leading-relaxed mb-8">
            Estudio jurídico con estándar de Santiago. Litigio estratégico en materia penal en toda la Provincia de Cardenal Caro: Pichilemu, Marchihue, Litueche, La Estrella, Navidad y Paredones.
          </p>
          <a href="https://wa.me/56985497497" class="inline-block bg-[#25D366] text-white px-8 py-4 font-medium tracking-widest uppercase text-sm hover:bg-[#1da851] transition-all duration-300">
            Consulta Inmediata
          </a>
        </div>
      </div>
    </section>

    <!-- Comunas -->
    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-12" data-aos="fade-up">
          <h2 class="text-3xl md:text-4xl font-semibold text-primary mb-4">
            Comunas que Atendemos
          </h2>
          <p class="text-text-light max-w-2xl mx-auto">
            Cobertura completa en la Provincia de Cardenal Caro y toda la VI Región de O'Higgins.
          </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
          <div class="bg-bg-light p-6 text-center" data-aos="fade-up" data-aos-delay="0">
            <h3 class="text-xl font-bold text-primary mb-2">Pichilemu</h3>
            <p class="text-text-light text-sm">Capital provincial. Costa. Litigio penal estratégico.</p>
          </div>

          <div class="bg-bg-light p-6 text-center" data-aos="fade-up" data-aos-delay="50">
            <h3 class="text-xl font-bold text-primary mb-2">Marchihue</h3>
            <p class="text-text-light text-sm">Comuna costera. Defensa penal y querellas.</p>
          </div>

          <div class="bg-bg-light p-6 text-center" data-aos="fade-up" data-aos-delay="100">
            <h3 class="text-xl font-bold text-primary mb-2">Litueche</h3>
            <p class="text-text-light text-sm">Comuna costera. Compliance penal.</p>
          </div>

          <div class="bg-bg-light p-6 text-center" data-aos="fade-up" data-aos-delay="150">
            <h3 class="text-xl font-bold text-primary mb-2">La Estrella</h3>
            <p class="text-text-light text-sm">Comuna interior. Litigio estratégico.</p>
          </div>

          <div class="bg-bg-light p-6 text-center" data-aos="fade-up" data-aos-delay="200">
            <h3 class="text-xl font-bold text-primary mb-2">Navidad</h3>
            <p class="text-text-light text-sm">Comuna costera. Defensa penal económico.</p>
          </div>

          <div class="bg-bg-light p-6 text-center" data-aos="fade-up" data-aos-delay="250">
            <h3 class="text-xl font-bold text-primary mb-2">Paredones</h3>
            <p class="text-text-light text-sm">Comuna rural. Querellas criminales.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-primary">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-3xl md:text-4xl font-light text-white mb-6" data-aos="fade-up">
          Consulta en Cardenal Caro
        </h2>
        <p class="text-white/80 mb-8" data-aos="fade-up" data-aos-delay="100">
          Litigio estratégico penal en toda la provincia. Estándar de Santiago, atención local.
        </p>
        <div class="flex flex-wrap justify-center gap-4" data-aos="fade-up" data-aos-delay="200">
          <a href="https://wa.me/56985497497" class="inline-block bg-[#25D366] text-white px-8 py-4 font-medium tracking-widest uppercase text-sm hover:bg-[#1da851] transition-all duration-300">
            WhatsApp Directo
          </a>
          <a href="tel:+56985497497" class="inline-block bg-white text-primary px-8 py-4 font-medium tracking-widest uppercase text-sm hover:bg-gray-100 transition-all duration-300">
            Llamar Ahora
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
