        // 5. Header Scroll + Menú Móvil
        var headerEl = document.getElementById('site-header');
        function onScroll() {
          if (headerEl) headerEl.classList.toggle('is-scrolled', window.scrollY > 28);
        }
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });

        var backdropEl = document.getElementById('mobile-menu-backdrop');
        var openMenuBtn = document.getElementById('menu-open-btn');
        var closeMenuBtn = document.getElementById('menu-close-btn');
        function closeMobileMenu() {
          if (backdropEl) backdropEl.style.display = 'none';
