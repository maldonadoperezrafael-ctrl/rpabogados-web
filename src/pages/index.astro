            moreLabelEl.textContent = isExpanded ? 'Mostrar menos' : 'Ver toda la actualidad';
          }

          insightsListEl.innerHTML = visible
            .map(function (item, idx) {
              var catLabel = item.category === 'Análisis' ? 'Análisis RP' : item.category;
              var detailText = item.category === 'Prensa' ? item.source + ' · ' + item.meta : item.meta + ' · ' + item.source;
              var rulingHtml = item.rulingUrl
                ? '<a href="' + item.rulingUrl + '" target="_blank" rel="noreferrer">Texto de la sentencia <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg></a>'
