---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="RP Abogados | Estrategia Legal & Litigación de Alta Complejidad">
  <Header />

  <main class="pt-20">
    <!-- Hero Section -->
    <section class="min-h-screen flex items-center bg-gradient-to-br from-bg-light to-white relative overflow-hidden">
      <div class="absolute inset-0 opacity-5">
        <div class="absolute top-20 left-10 w-72 h-72 bg-primary rounded-full blur-3xl"></div>
        <div class="absolute bottom-20 right-10 w-96 h-96 bg-accent rounded-full blur-3xl"></div>
      </div>

      <div class="max-w-6xl mx-auto px-4 py-20 relative z-10">
        <div class="max-w-3xl" data-aos="fade-up">
          <p class="text-accent font-medium tracking-widest uppercase mb-4 text-sm">
            Boutique Jurídica de Litigación Estratégica • Santiago & Regiones
          </p>
          <h1 class="text-5xl md:text-6xl lg:text-7xl mb-6 leading-tight">
            Litigación de Alta Exigencia & <span class="text-accent italic">Estrategia Jurídica Integral</span>
          </h1>
          <p class="text-xl text-text-light mb-8 leading-relaxed">
            Asesoría jurídica rigurosa y representación judicial ante Tribunales Ordinarios, Cortes de Apelaciones y Corte Suprema. Defensa patrimonial, penal económico y contencioso-administrativa con conducción directa y personalizada de cada causa por sus socios.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="#contacto" class="btn-primary">Solicitar Consulta Confidencial</a>
            <a href="https://wa.me/56985497497" class="btn-secondary">Atención por WhatsApp</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Barra de Pilares -->
    <section class="bg-primary text-white py-12">
      <div class="max-w-6xl mx-auto px-4">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          <div data-aos="fade-up" data-aos-delay="0">
            <div class="text-4xl font-light text-accent mb-2">15+</div>
            <div class="text-sm text-white/70">Años Trayectoria Jurídica y Sector Público</div>
          </div>
          <div data-aos="fade-up" data-aos-delay="100">
            <div class="text-4xl font-light text-accent mb-2">TS</div>
            <div class="text-sm text-white/70">Tribunales Superiores Corte Suprema, Apelaciones y TC</div>
          </div>
          <div data-aos="fade-up" data-aos-delay="200">
            <div class="text-4xl font-light text-accent mb-2">100%</div>
            <div class="text-sm text-white/70">Personalizado Conducción Exclusiva por Socios</div>
          </div>
          <div data-aos="fade-up" data-aos-delay="300">
            <div class="text-4xl font-light text-accent mb-2">S&R</div>
            <div class="text-sm text-white/70">Santiago & Regiones Presencial y Telemática</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Áreas de Práctica -->
    <section id="areas" class="section-padding bg-white">
      <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-16" data-aos="fade-up">
          <p class="text-accent font-medium tracking-widest uppercase mb-4 text-sm">Especialización Forense</p>
          <h2 class="text-4xl md:text-5xl mb-4">Áreas de Práctica</h2>
          <p class="text-text-light max-w-2xl mx-auto">
            Abordamos causas complejas con una visión estratégica orientada a resultados, combinando rigor técnico con experiencia práctica en los tribunales más exigentes.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <!-- Área 1: Civil -->
          <div class="card-lift bg-bg-light p-8" data-aos="fade-up" data-aos-delay="0">
            <div class="text-accent font-light text-5xl mb-4">01</div>
            <p class="text-accent text-sm font-medium tracking-widest uppercase mb-2">Civil & Patrimonial</p>
            <h3 class="text-2xl mb-4">Litigación Civil & Controversias Patrimoniales</h3>
            <p class="text-text-light mb-4">
              Representación especializada en juicios ordinarios y sumarios de alta cuantía ante tribunales civiles y Cortes de Apelaciones.
            </p>
            <ul class="space-y-2 text-sm text-text-light">
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">•</span>
                Particiones de herencias y liquidación de comunidades
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">•</span>
                Reclamos de expropiaciones fiscales y servidumbres
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">•</span>
                Indemnizaciones de perjuicios contractual y extracontractual
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">•</span>
                Resolución de contratos y controversias sobre inmuebles
              </li>
            </ul>
            <a href="#contacto" class="inline-flex items-center gap-2 text-accent font-medium mt-6 hover:gap-3 transition-all">
              Conocer detalles del área <span>→</span>
            </a>
          </div>

          <!-- Área 2: Penal -->
          <div class="card-lift bg-bg-light p-8" data-aos="fade-up" data-aos-delay="100">
            <div class="text-accent font-light text-5xl mb-4">02</div>
            <p class="text-accent text-sm font-medium tracking-widest uppercase mb-2">Penal & Compliance</p>
            <h3 class="text-2xl mb-4">Litigación Penal & Delitos Económicos</h3>
            <p class="text-text-light mb-4">
              Defensa penal especializada bajo el nuevo marco de la Ley N° 21.595 de Delitos Económicos y Medioambientales, y querellas corporativas.
            </p>
            <ul class="space-y-2 text-sm text-text-light">
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">•</span>
                Defensa en delitos de cuello y corbata y fraude corporativo
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">•</span>
                Delitos contra la administración pública y probidad
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">•</span>
                Interposición de querellas criminales estratégicas
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">•</span>
                Compliance penal y prevención de riesgos para empresas
              </li>
            </ul>
            <a href="#contacto" class="inline-flex items-center gap-2 text-accent font-medium mt-6 hover:gap-3 transition-all">
              Conocer detalles del área <span>→</span>
            </a>
          </div>

          <!-- Área 3: Público -->
          <div class="card-lift bg-bg-light p-8" data-aos="fade-up" data-aos-delay="200">
            <div class="text-accent font-light text-5xl mb-4">03</div>
            <p class="text-accent text-sm font-medium tracking-widest uppercase mb-2">Público & Regulatorio</p>
            <h3 class="text-2xl mb-4">Derecho Público & Contencioso Administrativo</h3>
            <p class="text-text-light mb-4">
              Asesoría de primer nivel en controversias frente al Estado, municipalidades, órganos fiscalizadores y compras públicas.
            </p>
            <ul class="space-y-2 text-sm text-text-light">
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">•</span>
                Recursos de Protección ante Cortes de Apelaciones y Suprema
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">•</span>
                Defensa en sumarios y sanciones de Superintendencias
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">•</span>
                Litigios en compras públicas ante el Tribunal de Contratación
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">•</span>
                Dictámenes y requerimientos ante Contraloría General
              </li>
            </ul>
            <a href="#contacto" class="inline-flex items-center gap-2 text-accent font-medium mt-6 hover:gap-3 transition-all">
              Conocer detalles del área <span>→</span>
            </a>
          </div>

          <!-- Área 4: Laboral -->
          <div class="card-lift bg-bg-light p-8" data-aos="fade-up" data-aos-delay="300">
            <div class="text-accent font-light text-5xl mb-4">04</div>
            <p class="text-accent text-sm font-medium tracking-widest uppercase mb-2">Laboral Estratégico</p>
            <h3 class="text-2xl mb-4">Litigación Laboral de Alta Cuantía</h3>
            <p class="text-text-light mb-4">
              Defensa y representación en juicios del trabajo complejos, desvinculaciones de alta dirección y tutelas de derechos fundamentales.
            </p>
            <ul class="space-y-2 text-sm text-text-light">
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">•</span>
                Despidos injustificados de directivos y altos ejecutivos
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">•</span>
                Juicios de tutela por vulneración de derechos fundamentales
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">•</span>
                Defensa de empresas frente a reclamaciones sindicales
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">•</span>
                Negociaciones complejas y acuerdos extrajudiciales
              </li>
            </ul>
            <a href="#contacto" class="inline-flex items-center gap-2 text-accent font-medium mt-6 hover:gap-3 transition-all">
              Conocer detalles del área <span>→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Diferenciadores / Pilares -->
    <section class="section-padding bg-bg-light">
      <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-16" data-aos="fade-up">
          <p class="text-accent font-medium tracking-widest uppercase mb-4 text-sm">Estándar Profesional</p>
          <h2 class="text-4xl md:text-5xl mb-4">Pilares de Nuestra Práctica</h2>
          <p class="text-text-light max-w-2xl mx-auto">
            Una firma legal boutique pensada para quienes buscan excelencia técnica y atención personalizada en asuntos de alta complejidad.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center p-8" data-aos="fade-up" data-aos-delay="0">
            <div class="w-16 h-16 bg-primary text-white flex items-center justify-center mx-auto mb-6 text-2xl font-light">01</div>
            <h3 class="text-xl mb-4">Conducción Directa por Abogados Titulares</h3>
            <p class="text-text-light text-sm leading-relaxed">
              En RP Abogados cada causa es asumida personalmente por sus socios fundadores y asociados senior con formación de posgrado. Su asunto no será derivado a abogados recién egresados ni pasantes.
            </p>
          </div>

          <div class="text-center p-8" data-aos="fade-up" data-aos-delay="100">
            <div class="w-16 h-16 bg-primary text-white flex items-center justify-center mx-auto mb-6 text-2xl font-light">02</div>
            <h3 class="text-xl mb-4">Rigor Técnico & Litigación Sustentada</h3>
            <p class="text-text-light text-sm leading-relaxed">
              Cada escrito, recurso y alegato es diseñado sobre una base sólida de doctrina jurídica actualizada y precedentes jurisprudenciales recientes de la Corte Suprema y el Tribunal Constitucional.
            </p>
          </div>

          <div class="text-center p-8" data-aos="fade-up" data-aos-delay="200">
            <div class="w-16 h-16 bg-primary text-white flex items-center justify-center mx-auto mb-6 text-2xl font-light">03</div>
            <h3 class="text-xl mb-4">Comunicación Permanente & Confidencialidad</h3>
            <p class="text-text-light text-sm leading-relaxed">
              Mantenemos a nuestros clientes informados en tiempo real sobre cada hito procesal, brindando claridad en los escenarios y resguardo irrestricto del secreto profesional y de la información sensible.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Cita Doctrinal -->
    <section class="py-24 bg-primary text-white relative overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-0 left-1/4 w-96 h-96 bg-accent rounded-full blur-3xl"></div>
      </div>
      <div class="max-w-4xl mx-auto px-4 text-center relative z-10" data-aos="fade-up">
        <svg class="w-12 h-12 mx-auto mb-8 text-accent opacity-50" viewBox="0 0 24 24" fill="currentColor">
          <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
        </svg>
        <blockquote class="text-2xl md:text-3xl font-light italic leading-relaxed mb-8">
          "Tu deber es luchar por el Derecho, pero el día que encuentres en conflicto el Derecho con la Justicia, lucha por la Justicia"
        </blockquote>
        <cite class="text-white/60 text-sm tracking-widest uppercase">— Jurista Universal</cite>
      </div>
    </section>

    <!-- Coyuntura Forense / Noticias -->
    <section id="noticias" class="section-padding bg-white">
      <div class="max-w-6xl mx-auto px-4">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12" data-aos="fade-up">
          <div>
            <p class="text-accent font-medium tracking-widest uppercase mb-4 text-sm">Coyuntura Forense</p>
            <h2 class="text-4xl md:text-5xl mb-4">Lo que está pasando en tribunales</h2>
            <p class="text-text-light">Edición Quincenal • Análisis jurisprudencial actualizado</p>
          </div>
          <a href="#" class="btn-secondary mt-4 md:mt-0">Ver todas las notas →</a>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <article class="card-lift bg-bg-light overflow-hidden" data-aos="fade-up" data-aos-delay="0">
            <div class="h-48 bg-primary/10 flex items-center justify-center">
              <svg class="w-16 h-16 text-primary/30" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L2 22h20L12 2zm0 3.99L19.53 19H4.47L12 5.99zM11 10h2v4h-2zm0 6h2v2h-2z"/></svg>
            </div>
            <div class="p-6">
              <p class="text-accent text-xs font-medium tracking-widest uppercase mb-2">Indemnizaciones</p>
              <h3 class="text-lg mb-3 leading-snug">Los jueces ya no pueden rebajar indemnizaciones «al ojo»: deben justificar cada peso</h3>
              <p class="text-text-light text-sm">
                Si un tribunal decide bajar el monto pedido por daño moral, tiene que fundamentar con peritajes y pruebas claras por qué lo hace.
              </p>
            </div>
          </article>

          <article class="card-lift bg-bg-light overflow-hidden" data-aos="fade-up" data-aos-delay="100">
            <div class="h-48 bg-primary/10 flex items-center justify-center">
              <svg class="w-16 h-16 text-primary/30" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
            </div>
            <div class="p-6">
              <p class="text-accent text-xs font-medium tracking-widest uppercase mb-2">Redes Sociales</p>
              <h3 class="text-lg mb-3 leading-snug">La Suprema frena las «funas»: prohibido acusar de delitos sin pruebas en internet</h3>
              <p class="text-text-light text-sm">
                El máximo tribunal ordenó bajar publicaciones en redes sociales que imputen delitos a personas sin contar con una condena judicial previa.
              </p>
            </div>
          </article>

          <article class="card-lift bg-bg-light overflow-hidden" data-aos="fade-up" data-aos-delay="200">
            <div class="h-48 bg-primary/10 flex items-center justify-center">
              <svg class="w-16 h-16 text-primary/30" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
            </div>
            <div class="p-6">
              <p class="text-accent text-xs font-medium tracking-widest uppercase mb-2">Tecnología & Secreto</p>
              <h3 class="text-lg mb-3 leading-snug">El peligro de ingresar datos confidenciales de clientes en IA pública</h3>
              <p class="text-text-light text-sm">
                Advierten sobre el riesgo inminente de vulnerar el secreto profesional y la reserva legal al subir antecedentes reservados de causas a plataformas de IA.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Equipo -->
    <section id="equipo" class="section-padding bg-bg-light">
      <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-16" data-aos="fade-up">
          <p class="text-accent font-medium tracking-widest uppercase mb-4 text-sm">Cuerpo Jurídico</p>
          <h2 class="text-4xl md:text-5xl mb-4">Equipo de Abogados</h2>
          <p class="text-text-light max-w-2xl mx-auto">
            Profesionales con trayectoria probada en el ejercicio forense, docencia universitaria y servicio público.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          <!-- Socio 1 -->
          <div class="card-lift bg-white p-8" data-aos="fade-up" data-aos-delay="0">
            <div class="flex items-start gap-6">
              <div class="w-20 h-20 bg-primary flex items-center justify-center flex-shrink-0">
                <span class="text-white text-2xl font-light">RP</span>
              </div>
              <div>
                <h3 class="text-xl mb-1">Rafael Pérez Maldonado</h3>
                <p class="text-accent text-sm font-medium mb-3">Socio Fundador</p>
                <p class="text-text-light text-sm leading-relaxed">
                  Abogado y Magíster en Derecho Público y Litigación Constitucional. Más de 15 años de trayectoria profesional en litigación forense, asesoría a instituciones públicas, tramitación legislativa y controversias patrimoniales complejas.
                </p>
                <a href="#" class="inline-flex items-center gap-2 text-accent font-medium mt-4 text-sm hover:gap-3 transition-all">
                  Ver perfil completo & trayectoria →
                </a>
              </div>
            </div>
          </div>

          <!-- Socio 2 -->
          <div class="card-lift bg-white p-8" data-aos="fade-up" data-aos-delay="100">
            <div class="flex items-start gap-6">
              <div class="w-20 h-20 bg-primary flex items-center justify-center flex-shrink-0">
                <span class="text-white text-2xl font-light">YS</span>
              </div>
              <div>
                <h3 class="text-xl mb-1">Yerko Scheihing Sepúlveda</h3>
                <p class="text-accent text-sm font-medium mb-3">Abogado Asociado</p>
                <p class="text-text-light text-sm leading-relaxed">
                  Especialista en litigación penal económica, derecho administrativo sancionatorio y cumplimiento normativo corporativo. Litigación en audiencias de control de detención, formalización y juicios orales.
                </p>
                <a href="#" class="inline-flex items-center gap-2 text-accent font-medium mt-4 text-sm hover:gap-3 transition-all">
                  Ver perfil completo & trayectoria →
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contacto -->
    <section id="contacto" class="section-padding bg-white">
      <div class="max-w-6xl mx-auto px-4">
        <div class="grid md:grid-cols-2 gap-12">
          <div data-aos="fade-right">
            <p class="text-accent font-medium tracking-widest uppercase mb-4 text-sm">Atención Personalizada</p>
            <h2 class="text-4xl md:text-5xl mb-6">Contacto & Ubicación</h2>
            <p class="text-text-light mb-8">
              Recepción de antecedentes y atención presencial en nuestras oficinas de Providencia, Santiago. También atención telemática en todo Chile.
            </p>

            <div class="space-y-4">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-bg-light flex items-center justify-center flex-shrink-0">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="#FC5D23"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                </div>
                <div>
                  <h4 class="font-semibold mb-1">Dirección</h4>
                  <p class="text-text-light text-sm">Providencia, Santiago, Chile</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-bg-light flex items-center justify-center flex-shrink-0">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="#FC5D23"><path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 0 0-1.01.24l-2.2 2.2a15.053 15.053 0 0 1-6.59-6.59l2.2-2.21a.96.96 0 0 0 .25-1.01A11.36 11.36 0 0 1 8.5 3.92c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1 0 9.39 7.61 17 17 17 .55 0 1-.45 1-1v-3.54c0-.54-.45-.99-.99-.99z"/></svg>
                </div>
                <div>
                  <h4 class="font-semibold mb-1">Teléfono</h4>
                  <a href="tel:+56985497497" class="text-text-light text-sm hover:text-accent transition-colors">+56 9 8549 7497</a>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-bg-light flex items-center justify-center flex-shrink-0">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="#FC5D23"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
                </div>
                <div>
                  <h4 class="font-semibold mb-1">Email</h4>
                  <a href="mailto:contacto@rpabogados.cl" class="text-text-light text-sm hover:text-accent transition-colors">contacto@rpabogados.cl</a>
                </div>
              </div>
            </div>

            <div class="flex gap-4 mt-8">
              <a href="https://wa.me/56985497497" class="btn-primary">WhatsApp Directo</a>
