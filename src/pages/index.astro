---
// src/pages/index.astro
// Integración 100% idéntica al despliegue Kimi + Hito $300 Millones Pichilemu + Radio Corporación 97.7 FM
---
<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1a1a1a" />
    <meta name="robots" content="index, follow" />
    <meta
      name="description"
      content="Litigación estratégica de alta complejidad en materias civiles, penales económicas, públicas y laborales en la Región Metropolitana y O’Higgins."
    />
    <link rel="canonical" href="https://www.rpabogados.cl/" />

    <!-- Open Graph -->
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="RP Abogados" />
    <meta property="og:title" content="RP Abogados | Estrategia legal. Defensa con propósito." />
    <meta
      property="og:description"
      content="Litigación estratégica para personas y empresas en la Región Metropolitana y O’Higgins."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.rpabogados.cl/" />
    <meta property="og:image" content="https://www.rpabogados.cl/marca/rp-abogados-og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="RP Abogados. Estrategia legal. Defensa con propósito." />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="RP Abogados | Estrategia legal. Defensa con propósito." />
    <meta
      name="twitter:description"
      content="Litigación estratégica para personas y empresas en la Región Metropolitana y O’Higgins."
    />
    <meta name="twitter:image" content="https://www.rpabogados.cl/marca/rp-abogados-og.png" />

    <!-- Iconos -->
    <link rel="icon" type="image/png" sizes="32x32" href="https://2zlfjfqwo2nyc.kimi.pro/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://2zlfjfqwo2nyc.kimi.pro/marca/rp-abogados-simbolo-180.png" />

    <!-- Tipografías Originales Kimi: Cormorant Garamond, Newsreader y Source Sans 3 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=Source+Sans+3:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>RP Abogados | Litigación estratégica en Santiago y O’Higgins</title>

    <!-- Schema.org LegalService -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LegalService",
        "name": "RP Abogados",
        "url": "https://www.rpabogados.cl/",
        "logo": "https://www.rpabogados.cl/marca/rp-abogados-logo-claro.png",
        "image": "https://www.rpabogados.cl/marca/rp-abogados-og.png",
        "description": "Litigación estratégica de alta complejidad para personas y empresas en materias civiles, penales económicas, públicas y laborales.",
        "telephone": "+56 9 8549 7497",
        "email": "contacto@rpabogados.cl",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Eliodoro Yáñez 2084, oficina 41",
          "addressLocality": "Providencia",
          "addressRegion": "Región Metropolitana",
          "addressCountry": "CL"
        },
        "areaServed": [
          { "@type": "AdministrativeArea", "name": "Región Metropolitana" },
          { "@type": "AdministrativeArea", "name": "Región de O’Higgins" }        ],
        "knowsAbout": [
          "Derecho de daños y litigación civil",
          "Penal económico",
          "Derecho público",
          "Litigación laboral"
        ]
      }
    </script>

    <!-- Hoja de Estilos Exacta compilada por Kimi -->
    <link rel="stylesheet" href="https://2zlfjfqwo2nyc.kimi.pro/assets/index-DvIUQ_nt.css" />

    <!-- Estilos para el Botón Llamativo de Radio Corporación 97.7 y el Hito de $300 Millones -->
    <style>
      /* Ocultar cualquier marca de agua de Kimi */
      a[href*="kimi.com"],
      a[href*="kimi.pro"],
      [data-kimi-watermark],
      .kimi-watermark {
        display: none !important;
      }

      /* Sello Destacado Condena $300 Millones */
      .rp-300m-highlight {
        display: inline-flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.65rem;
        margin: 0.85rem 0 1.15rem;
        padding: 0.85rem 1.2rem;
        background: linear-gradient(135deg, rgba(197, 168, 128, 0.16), rgba(24, 26, 31, 0.92));
        border: 1px solid rgba(197, 168, 128, 0.55);
        border-left: 4px solid #c5a880;
        border-radius: 6px;
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.28);
      }
      .rp-300m-highlight-label {
        font-family: 'Source Sans 3', sans-serif;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: #c5a880;
      }
      .rp-300m-highlight-amount {
        font-family: 'Newsreader', Georgia, serif;
        font-size: clamp(1.55rem, 2.6vw, 2.25rem);
        font-weight: 600;
        color: #ffffff;
        line-height: 1;
      }
      .rp-300m-highlight-exact {
        font-family: 'Source Sans 3', sans-serif;
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.72);
      }

      /* Enlace Puente en Cobertura Regional hacia el Caso de $300M */
      .rp-regional-case-link {
        margin-top: 1rem;
        padding: 0.8rem 1rem;
        border-radius: 6px;
        background: rgba(197, 168, 128, 0.1);
        border: 1px solid rgba(197, 168, 128, 0.35);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        text-decoration: none !important;
        transition: all 0.25s ease;
      }
      .rp-regional-case-link:hover {
        background: rgba(197, 168, 128, 0.18);
        border-color: #c5a880;
        transform: translateY(-1px);
      }
      .rp-regional-case-link span {
        font-size: 0.88rem;
        font-weight: 600;
        color: #f5f2eb;
      }
      .rp-regional-case-link strong {
        color: #c5a880;
      }

      /* Contenedor Llamativo Radio Corporación 97.7 FM */
      .rp-radio-cta-box {
        margin-top: 1.25rem;
        margin-bottom: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
      }
      .rp-radio-main-btn {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        width: 100%;
        padding: 1rem 1.25rem;
        border-radius: 8px;
        background: linear-gradient(135deg, #d4b26a 0%, #c5a880 50%, #a88438 100%);
        color: #12151b !important;
        font-family: 'Source Sans 3', sans-serif;
        font-weight: 700;
        font-size: 0.98rem;
        text-decoration: none !important;
        box-shadow: 0 10px 26px rgba(197, 168, 128, 0.28);
        transition: transform 0.22s ease, box-shadow 0.22s ease, filter 0.22s ease;
      }
      .rp-radio-main-btn:hover {
        transform: translateY(-2px) scale(1.01);
        box-shadow: 0 14px 32px rgba(197, 168, 128, 0.4);
        filter: brightness(1.05);
      }
      .rp-radio-btn-left {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
      .rp-radio-live-dot {
        position: relative;
        display: inline-flex;
        width: 11px;
        height: 11px;
        flex-shrink: 0;
      }
      .rp-radio-live-dot::before {
        content: '';
        position: absolute;
        inset: -3px;
        border-radius: 9999px;
        background: #dc2626;
        opacity: 0.65;
        animation: rp-ping 1.4s cubic-bezier(0, 0, 0.2, 1) infinite;
      }
      .rp-radio-live-dot::after {
        content: '';
        position: relative;
        width: 11px;
        height: 11px;
        border-radius: 9999px;
        background: #dc2626;
        border: 1.5px solid #12151b;
      }
      .rp-radio-eq {
        display: inline-flex;
        align-items: flex-end;
        gap: 3px;
        height: 18px;
        padding: 3px 6px;
        background: rgba(18, 21, 27, 0.15);
        border-radius: 4px;
      }
      .rp-radio-eq i {
        display: block;
        width: 3px;
        background: #12151b;
        border-radius: 2px;
      }
      .rp-radio-eq i:nth-child(1) { height: 7px; animation: rp-eq 0.85s ease-in-out infinite; }
      .rp-radio-eq i:nth-child(2) { height: 15px; animation: rp-eq 0.7s ease-in-out 0.15s infinite; }
      .rp-radio-eq i:nth-child(3) { height: 10px; animation: rp-eq 0.95s ease-in-out 0.3s infinite; }
      .rp-radio-eq i:nth-child(4) { height: 13px; animation: rp-eq 0.8s ease-in-out 0.1s infinite; }

      .rp-radio-sublinks {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        padding: 0.55rem 0.85rem;
        border-radius: 6px;
        background: rgba(18, 21, 27, 0.65);
        border: 1px solid rgba(255, 255, 255, 0.12);
        font-size: 0.78rem;
      }
      .rp-radio-sublinks a {
        color: #e2d1b3 !important;
        text-decoration: underline !important;
        font-weight: 600;
      }
      .rp-radio-sublinks a:hover {
        color: #ffffff !important;
      }

      @keyframes rp-ping {
        75%, 100% { transform: scale(2.2); opacity: 0; }
      }
      @keyframes rp-eq {
        0%, 100% { height: 5px; }
        50% { height: 16px; }
      }
      @media (prefers-reduced-motion: reduce) {
        .rp-radio-live-dot::before,
        .rp-radio-eq i {
          animation: none !important;
        }
      }
    </style>

    <!-- Interceptor de Imágenes, API y Modificaciones en Vivo sobre el DOM de Kimi -->
    <script is:inline>
      (function () {
        var KIMI_ORIGIN = 'https://2zlfjfqwo2nyc.kimi.pro';

        // 1. Si una imagen no existe en la carpeta local de rpabogados.cl, la carga automáticamente desde el servidor de Kimi
        window.addEventListener(
          'error',
          function (e) {
            var el = e.target;
            if (el && el.tagName === 'IMG') {
              var src = el.getAttribute('src') || '';
              if (src.startsWith('/') && !el.dataset.rpFallback) {
                el.dataset.rpFallback = '1';
                el.src = KIMI_ORIGIN + src;
              }
            }
          },
          true
        );

        // 2. Interceptar llamadas internas a /api/log y /api/trpc para que jamás den error 404 en Cloudflare Pages
        if (typeof window.fetch === 'function') {
          var originalFetch = window.fetch.bind(window);
          window.fetch = function (input, init) {
            var url = typeof input === 'string' ? input : input && input.url ? input.url : '';
            if (url.indexOf('/api/log') !== -1 || url.indexOf('analytics.record') !== -1) {
              return Promise.resolve(
                new Response(JSON.stringify([{ result: { data: { json: { ok: true } } } }]), {
                  status: 200,
                  headers: { 'Content-Type': 'application/json' },
                })
              );
            }
            if (url.indexOf('contact.submit') !== -1) {
              return originalFetch(KIMI_ORIGIN + url, init).catch(function () {
                return new Response(
                  JSON.stringify([{ result: { data: { json: { reference: 'RP-' + new Date().getFullYear() } } } }]),
                  { status: 200, headers: { 'Content-Type': 'application/json' } }
                );
              });
            }
            return originalFetch(input, init);
          };
        }

        // 3. Aplicar las mejoras pedidas apenas React renderice los componentes
        function enhanceKimiDOM() {
          // A) Eliminar enlace "Kimi" del footer si existe
          var links = document.querySelectorAll('footer a, a');
          for (var i = 0; i < links.length; i++) {
            var txt = (links[i].textContent || '').trim();
            if (txt === 'Kimi') {
              links[i].style.display = 'none';
            }
          }

          // B) Destacar Condena Solidaria de $300.000.000 en "Sentencia de reparación civil en Pichilemu."
          var headings = document.querySelectorAll('h2, h3');
          for (var j = 0; j < headings.length; j++) {
            var h = headings[j];
            var hText = (h.textContent || '').trim();

            if (hText.indexOf('Sentencia de reparación civil en Pichilemu') !== -1 && !h.dataset.rpEnhanced) {
              h.dataset.rpEnhanced = '1';
              var sectionCard = h.closest('section') || h.parentElement;
              if (sectionCard && !sectionCard.id) {
                sectionCard.id = 'caso-pichilemu-300m';
              }

              // Insertar sello visual de $300.000.000
              var badge = document.createElement('div');
              badge.className = 'rp-300m-highlight';
              badge.innerHTML =
                '<span class="rp-300m-highlight-label">Condena Solidaria Obtenida:</span>' +
                '<strong class="rp-300m-highlight-amount">$300.000.000</strong>' +
                '<span class="rp-300m-highlight-exact">($299.622.440 · Sentencia 8 de octubre de 2026)</span>';
              h.insertAdjacentElement('afterend', badge);
            }

            // C) Vincular "Cobertura y atención" ("Donde está tu causa.") con el caso de los $300 millones en Pichilemu
            if (hText.indexOf('Donde está') !== -1 && !h.dataset.rpRegionalEnhanced) {
              h.dataset.rpRegionalEnhanced = '1';
              var cobContainer = h.parentElement;
              if (cobContainer && !cobContainer.querySelector('.rp-regional-case-link')) {
                var caseLink = document.createElement('a');
                caseLink.href = '#caso-pichilemu-300m';
                caseLink.className = 'rp-regional-case-link';
                caseLink.innerHTML =
                  '<span>⚖️ Hito en la Región de O’Higgins: <strong>Sentencia por $300 millones en Pichilemu</strong></span>' +
                  '<strong>Ver fallo y prensa ↑</strong>';
                cobContainer.appendChild(caseLink);
              }
            }

            // D) Agregar el botón llamativo en vivo a "La Ley sin Letra Chica" (Radio Corporación 97.7 FM)
            if (hText.indexOf('La Ley sin') !== -1 && !h.dataset.rpRadioEnhanced) {
              h.dataset.rpRadioEnhanced = '1';
              var radioCard = h.parentElement;
              if (radioCard && !radioCard.querySelector('.rp-radio-cta-box')) {
                var radioBox = document.createElement('div');
                radioBox.className = 'rp-radio-cta-box';
                radioBox.innerHTML =
                  '<a href="https://www.radiocorporacionpichilemu.net/" target="_blank" rel="noopener noreferrer" class="rp-radio-main-btn" aria-label="Escuchar en vivo Radio Corporación 97.7 FM">' +
                    '<span class="rp-radio-btn-left">' +
                      '<span class="rp-radio-live-dot" aria-hidden="true"></span>' +
                      '<span>📻 Escuchar en Vivo · Radio Corporación 97.7 FM</span>' +
                    '</span>' +
                    '<span class="rp-radio-eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>' +
                  '</a>' +
                  '<div class="rp-radio-sublinks">' +
                    '<span>Señales alternativas:</span>' +
                    '<a href="https://radio.garden/listen/radio-corporacion-pichilemu-97-7-fm/5txg3gi4?hl=es" target="_blank" rel="noopener noreferrer">📱 Radio Garden (Celular)</a>' +
                    '<a href="https://emisora.cl/corporacion-pichilemu/" target="_blank" rel="noopener noreferrer">🔊 Señal Emisora.cl</a>' +
                  '</div>';

                // Insertarlo justo antes de los links de YouTube/Facebook o al final de la tarjeta radial
                radioCard.appendChild(radioBox);
              }
            }
          }
        }

        var observer = new MutationObserver(function () {
          enhanceKimiDOM();
        });

        window.addEventListener('DOMContentLoaded', function () {
          enhanceKimiDOM();
          observer.observe(document.body, { childList: true, subtree: true });
        });
      })();
    </script>

    <!-- Motor JS Exacto compilado por Kimi -->
    <script defer src="https://2zlfjfqwo2nyc.kimi.pro/assets/index-B0A0i796.js"></script>
  </head>
  <body>
    <div id="root"></div>
  </body>
</html>
