    <!-- Estilos Base de Kimi (App.css) -->
    <link rel="stylesheet" href="https://2zlfjfqwo2nyc.kimi.pro/assets/index-DvIUQ_nt.css" />

    <!-- Reemplazo Total de Naranjo/Terracota por Azul Ejecutivo + Dorado Sobrio (#C5A880) -->
    <style>
      :root {
        --terracotta: #2563eb !important;
        --terracotta-light: #60a5fa !important;
        --terracotta-dark: #1e3a8a !important;
        --accent: #1e40af !important;
        --gold: #C5A880 !important;
      }

      /* Eliminar cualquier tono naranjo/cobrizo en títulos, cursivas, kickers y enlaces */
      .hero-kicker,
      .section-kicker,
      .case-kicker,
      .method-number,
      .radio-live,
      .radio-station strong,
      .insight-category,
      .contact-nav-link {
        color: #C5A880 !important;
      }

      .hero-title em,
      .regional-copy h2 em,
      .philosophy-grid h2 em {
        color: #7aa2d4 !important; /* Azul acero elegante sobre fondo oscuro/claro */
      }

      .philosophy-grid h2 em,
      .area-item.is-active h3 button span,
      .faq-item.is-open h3 button span,
      .text-link,
      .case-sources a,
      .case-reference figcaption a,
      .insight-detail a,
      .office-map-link {
        color: #1e3a5f !important; /* Azul marino corporativo sobre secciones claras */
      }

      .text-link-light,
      .region-places a,
      .whatsapp-link {
        color: #C5A880 !important;
      }

      /* Botones principales en Azul Marino Ejecutivo con borde Dorado */
      .button-primary,
      .form-submit {
        background: #162a45 !important;
        border: 1px solid #C5A880 !important;
        color: #ffffff !important;
        transition: all 0.2s ease !important;
      }
      .button-primary:hover,
      .form-submit:hover {
        background: #1e3a5f !important;
        border-color: #e2c9a6 !important;
      }

      /* Enlaces interactivos en la barra inferior del Hero */
      .hero-practices a {
        color: rgba(245, 242, 235, 0.85);
        text-decoration: none;
        transition: color 0.2s ease, transform 0.2s ease;
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.4rem;
      }
      .hero-practices a:hover {
        color: #7aa2d4 !important;
        transform: translateY(-1px);
      }

      /* Condena $300M en Azul y Dorado */
      .case-award {
        margin: 1.5rem 0 1.75rem;
        padding: 1.15rem 1.35rem;
        border-left: 3px solid #1e3a5f;
        background: rgba(30, 58, 95, 0.06);
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
      }
      .case-award span {
        font-size: 0.76rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: #1e3a5f;
      }
      .case-award strong {
        font-family: 'Newsreader', Georgia, serif;
        font-size: clamp(1.9rem, 3.2vw, 2.65rem);
        font-weight: 600;
        line-height: 1.05;
        color: #0f172a;
      }
      .case-award small {
        font-size: 0.85rem;
        color: #475569;
      }

      /* Radio Corporación 97.7 FM en Azul Ejecutivo + Dorado */
      .radio-live {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
      }
      .radio-live-dot {
        position: relative;
        display: inline-flex;
        width: 9px;
        height: 9px;
        border-radius: 999px;
        background: #3b82f6;
        flex-shrink: 0;
      }
      .radio-live-dot::after {
        content: '';
        position: absolute;
        inset: -4px;
        border-radius: 999px;
        background: rgba(59, 130, 246, 0.45);
        animation: rpPulse 1.5s ease-out infinite;
      }
      .radio-eq {
        display: inline-flex;
        align-items: flex-end;
        gap: 2.5px;
        height: 14px;
      }
      .radio-eq i {
        display: block;
        width: 2.5px;
        background: currentColor;
        border-radius: 2px;
      }
      .radio-eq i:nth-child(1) { height: 6px; animation: rpEq 0.8s ease-in-out infinite; }
      .radio-eq i:nth-child(2) { height: 13px; animation: rpEq 0.65s ease-in-out 0.15s infinite; }
      .radio-eq i:nth-child(3) { height: 8px; animation: rpEq 0.9s ease-in-out 0.3s infinite; }

      .radio-live-cta {
        margin: 1.15rem 0 0.9rem;
        padding: 0.95rem 1.2rem;
        border-radius: 6px;
        background: linear-gradient(135deg, #1e3a5f 0%, #162a45 100%);
        border: 1px solid #C5A880;
        color: #ffffff !important;
        font-weight: 700;
        font-size: 0.96rem;
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.8rem;
        width: 100%;
        text-decoration: none !important;
        box-shadow: 0 10px 26px rgba(15, 23, 42, 0.45);
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
      }
      .radio-live-cta:hover {
        transform: translateY(-2px);
        background: linear-gradient(135deg, #254b7c 0%, #1e3a5f 100%);
        box-shadow: 0 14px 30px rgba(30, 58, 95, 0.55);
      }
      .radio-live-cta .radio-live-dot {
        background: #60a5fa;
      }
      @keyframes rpPulse {
        75%, 100% { transform: scale(2.1); opacity: 0; }
      }
      @keyframes rpEq {
        0%, 100% { height: 4px; }
        50% { height: 14px; }
      }
      @media (prefers-reduced-motion: reduce) {
        .radio-live-dot::after,
        .radio-eq i {
          animation: none !important;
        }
      }
    </style>
  </head>

