          <div class="absolute inset-0 bg-black/60 group-hover:bg-black/45 transition-all duration-500"></div>
          <div class="relative z-10 h-full flex flex-col justify-end p-6">
            <span class="text-xs font-bold uppercase tracking-widest text-[#C5A880] mb-1">02 / Penal</span>
            <h3 class="text-white text-xl font-semibold mb-2">Litigación Penal &amp; Compliance</h3>
