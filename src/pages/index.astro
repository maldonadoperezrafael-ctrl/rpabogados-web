---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="RP Abogados | Litigio Estratégico Penal Santiago y VI Región">
  <Header />

  <main class="pt-0">
    <!-- Hero Section Estilo Colombara -->
    <section class="relative min-h-screen flex items-end overflow-hidden">
      <!-- Imagen de fondo -->
      <div class="absolute inset-0">
        <img src="/fotos/hero-textura.jpg" alt="" class="w-full h-full object-cover">
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent"></div>
      </div>

      <!-- Contenido -->
      <div class="relative z-10 w-full max-w-7xl mx-auto px-6 pb-20">
        <div class="max-w-4xl" data-aos="fade-up">
          <h1 class="text-white text-5xl md:text-7xl lg:text-8xl font-light leading-none mb-6 tracking-tight">
            RP<br>ABOGADOS
          </h1>
          <div class="w-24 h-1 bg-accent mb-8"></div>
          <p class="text-white/90 text-lg md:text-xl font-light leading-relaxed max-w-2xl mb-8">
            Estudio jurídico orientado en litigación de alta complejidad, en juicios de derechos de daños, en delitos penales económicos-tributarios y de alta connotación social, contencioso administrativos, acción constitucionales, derecho migratorio y derecho laboral de la empresa colectivo e individual. Desde Santiago y la Región de O'Higgins, asesoramos a personas, empresas e instituciones en los casos más desafiantes, con un enfoque estratégico, ético y orientado a resultados.
          </p>
          <a href="#contacto" class="inline-block bg-[#25D366] text-white px-8 py-4 font-medium tracking-widest uppercase text-sm hover:bg-[#1da851] transition-all duration-300">
            Solicitar Consulta
          </a>
        </div>
      </div>
    </section>

    <!-- Sección: Pilares de Nuestra Práctica -->
    <section class="py-16 bg-slate-50 border-t border-b border-slate-200" id="pilares">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <span class="text-xs font-bold uppercase tracking-widest text-[#C5A880] block mb-2">Estándar Profesional</span>
          <h2 class="text-3xl font-bold text-slate-900 tracking-tight">Pilares de Nuestra Práctica</h2>
          <div class="w-12 h-0.5 bg-[#C5A880] mx-auto mt-4"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Pilar I -->
          <div class="bg-white p-8 rounded-md border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
            <span class="text-sm font-extrabold text-[#C5A880] tracking-wider block mb-3">01</span>
            <h3 class="text-lg font-bold text-slate-900 mb-3">Dirección Personalizada de Cada Causa</h3>
            <p class="text-slate-600 text-sm leading-relaxed text-justify">
              Lideramos personalmente el desarrollo de cada caso, integrando la experiencia y el análisis crítico de todo el equipo en cada etapa del proceso.
            </p>
          </div>

          <!-- Pilar II -->
          <div class="bg-white p-8 rounded-md border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
            <span class="text-sm font-extrabold text-[#C5A880] tracking-wider block mb-3">02</span>
            <h3 class="text-lg font-bold text-slate-900 mb-3">Fundamentación y Precisión Técnica</h3>
            <p class="text-slate-600 text-sm leading-relaxed text-justify">
              Sustentamos nuestras estrategias legales sobre la base del análisis exhaustivo de la legislación especializada, la doctrina y los precedentes jurisprudenciales consolidados, construyendo argumentos rigurosos, verificables y de alto estándar técnico.
            </p>
          </div>

          <!-- Pilar III -->
          <div class="bg-white p-8 rounded-md border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
            <span class="text-sm font-extrabold text-[#C5A880] tracking-wider block mb-3">03</span>
            <h3 class="text-lg font-bold text-slate-900 mb-3">Comunicación Permanente y Confidencialidad</h3>
            <p class="text-slate-600 text-sm leading-relaxed text-justify">
              Mantenemos a nuestros clientes informados sobre el avance del proceso que llevamos junto a ellos, brindando claridad de escenarios y rigurosidad técnica para enfrentar cada etapa.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Barra de Datos -->
    <section class="bg-primary text-white py-12">
      <div class="max-w-6xl mx-auto px-4">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          <div data-aos="fade-up" data-aos-delay="0">
            <div class="text-4xl font-light text-accent mb-2">15+</div>
            <div class="text-sm text-white/70">Años de Trayectoria Jurídica y Sector Público</div>
          </div>
          <div data-aos="fade-up" data-aos-delay="100">
            <div class="text-4xl font-light text-accent mb-2">TS</div>
            <div class="text-sm text-white/70">Tribunales Superiores: Corte Suprema, Cortes de Apelaciones y Tribunal Constitucional</div>
          </div>
          <div data-aos="fade-up" data-aos-delay="200">
            <div class="text-4xl font-light text-accent mb-2">100%</div>
            <div class="text-sm text-white/70">Conducción Exclusiva por Socios</div>
          </div>
          <div data-aos="fade-up" data-aos-delay="300">
            <div class="text-4xl font-light text-accent mb-2">RM-VI</div>
            <div class="text-sm text-white/70">Región Metropolitana y VI Región de O'Higgins</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Áreas de Práctica Estilo Colombara -->
    <section id="areas" class="py-0 bg-white">
      <div class="text-center py-16 bg-bg-light">
        <h2 class="text-4xl md:text-5xl font-light text-primary">Áreas de práctica</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4">
        <div class="relative h-96 overflow-hidden group cursor-pointer" data-aos="fade-up" data-aos-delay="0">
          <img src="/fotos/area-civil.jpg" alt="Litigación Civil" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
          <div class="absolute inset-0 bg-black/50 group-hover:bg-black/40 transition-all duration-500"></div>
          <div class="relative z-10 h-full flex flex-col justify-end p-6">
            <h3 class="text-white text-2xl font-semibold mb-2">Litigación Civil</h3>
            <div class="w-12 h-0.5 bg-accent mb-4"></div>
            <ul class="text-white/80 text-sm space-y-1 opacity-0 group-hover:opacity-100 transition-opacity duration-500">
              <li>• Particiones de herencias</li>
              <li>• Reclamos por ocupación de terrenos</li>
              <li>• Responsabilidad contractual</li>
              <li>• Controversias sobre inmuebles</li>
            </ul>
          </div>
        </div>

        <div class="relative h-96 overflow-hidden group cursor-pointer" data-aos="fade-up" data-aos-delay="100">
          <img src="/fotos/area-penal.jpg" alt="Litigación Penal" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
          <div class="absolute inset-0 bg-black/50 group-hover:bg-black/40 transition-all duration-500"></div>
          <div class="relative z-10 h-full flex flex-col justify-end p-6">
            <h3 class="text-white text-2xl font-semibold mb-2">Litigación Penal</h3>
            <div class="w-12 h-0.5 bg-accent mb-4"></div>
            <ul class="text-white/80 text-sm space-y-1 opacity-0 group-hover:opacity-100 transition-opacity duration-500">
              <li>• Compliance</li>
              <li>• Querellas criminales</li>
              <li>• Representación penal</li>
            </ul>
          </div>
        </div>

        <div class="relative h-96 overflow-hidden group cursor-pointer" data-aos="fade-up" data-aos-delay="200">
          <img src="/fotos/area-publico.jpg" alt="Derecho Público" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
          <div class="absolute inset-0 bg-black/50 group-hover:bg-black/40 transition-all duration-500"></div>
          <div class="relative z-10 h-full flex flex-col justify-end p-6">
            <h3 class="text-white text-2xl font-semibold mb-2">Derecho Público</h3>
            <div class="w-12 h-0.5 bg-accent mb-4"></div>
            <ul class="text-white/80 text-sm space-y-1 opacity-0 group-hover:opacity-100 transition-opacity duration-500">
              <li>• Procesos disciplinarios</li>
              <li>• Juicios de cuentas</li>
              <li>• Acciones constitucionales</li>
              <li>• Tribunal de Contratación Pública</li>
            </ul>
          </div>
        </div>

        <div class="relative h-96 overflow-hidden group cursor-pointer" data-aos="fade-up" data-aos-delay="300">
          <img src="/fotos/area-laboral.jpg" alt="Derecho Laboral" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
          <div class="absolute inset-0 bg-black/50 group-hover:bg-black/40 transition-all duration-500"></div>
          <div class="relative z-10 h-full flex flex-col justify-end p-6">
            <h3 class="text-white text-2xl font-semibold mb-2">Derecho Laboral</h3>
            <div class="w-12 h-0.5 bg-accent mb-4"></div>
            <ul class="text-white/80 text-sm space-y-1 opacity-0 group-hover:opacity-100 transition-opacity duration-500">
              <li>• Negociaciones colectivas</li>
              <li>• Sector público y privado</li>
              <li>• Representación trabajador y empleador</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Cita Doctrinal con Rotación -->
    <section class="py-24 bg-primary text-white relative overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-0 left-1/4 w-96 h-96 bg-accent rounded-full blur-3xl"></div>
      </div>
      <div class="max-w-4xl mx-auto px-4 text-center relative z-10" data-aos="fade-up">
        <svg class="w-12 h-12 mx-auto mb-8 text-accent opacity-50" viewBox="0 0 24 24" fill="currentColor">
          <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
        </svg>

        <div class="quote-container relative min-h-[200px] flex items-center justify-center">
          <div class="quote-slide absolute inset-0 flex flex-col items-center justify-center opacity-100 transition-opacity duration-1000" data-quote="0">
            <blockquote class="text-2xl md:text-3xl font-light italic leading-relaxed mb-8">
              "La justicia es la constante y perpetua voluntad de dar a cada uno su derecho"
            </blockquote>
            <cite class="text-white/60 text-sm tracking-widest uppercase">— Ulpiano (170-228), Jurista Romano</cite>
          </div>

          <div class="quote-slide absolute inset-0 flex flex-col items-center justify-center opacity-0 transition-opacity duration-1000 pointer-events-none" data-quote="1">
            <blockquote class="text-2xl md:text-3xl font-light italic leading-relaxed mb-8">
              "La ciencia que se aparte de la justicia, más que ciencia, debe llamarse astucia"
            </blockquote>
            <cite class="text-white/60 text-sm tracking-widest uppercase">— Marco Tulio Cicerón (106-43 a.C.), Orador y Jurista Romano</cite>
          </div>

          <div class="quote-slide absolute inset-0 flex flex-col items-center justify-center opacity-0 transition-opacity duration-1000 pointer-events-none" data-quote="2">
            <blockquote class="text-2xl md:text-3xl font-light italic leading-relaxed mb-8">
              "Una cosa no es justa por el hecho de ser ley. Debe ser ley porque es justa"
            </blockquote>
            <cite class="text-white/60 text-sm tracking-widest uppercase">— Montesquieu (1689-1755), Filósofo y Jurista Francés</cite>
          </div>

          <div class="quote-slide absolute inset-0 flex flex-col items-center justify-center opacity-0 transition-opacity duration-1000 pointer-events-none" data-quote="3">
            <blockquote class="text-2xl md:text-3xl font-light italic leading-relaxed mb-8">
              "El rey mismo no debe estar sujeto al hombre, sino a Dios y a la ley, porque la ley lo hace rey"
            </blockquote>
            <cite class="text-white/60 text-sm tracking-widest uppercase">— Edward Coke (1552-1634), Jurista Británico</cite>
          </div>
        </div>

        <div class="flex justify-center gap-3 mt-8">
          <button class="quote-dot w-2 h-2 rounded-full bg-accent transition-all duration-300" data-target="0" aria-label="Cita 1"></button>
          <button class="quote-dot w-2 h-2 rounded-full bg-white/30 transition-all duration-300" data-target="1" aria-label="Cita 2"></button>
          <button class="quote-dot w-2 h-2 rounded-full bg-white/30 transition-all duration-300" data-target="2" aria-label="Cita 3"></button>
          <button class="quote-dot w-2 h-2 rounded-full bg-white/30 transition-all duration-300" data-target="3" aria-label="Cita 4"></button>
        </div>
      </div>
    </section>

    <!-- Coyuntura Forense / Noticias -->
    <section id="noticias" class="py-0 bg-white">
      <div class="relative overflow-hidden mb-8">
        <div class="absolute inset-0">
          <img src="/fotos/textura-verde.jpg" alt="" class="w-full h-full object-cover">
          <div class="absolute inset-0 bg-black/40"></div>
        </div>
        <div class="relative z-10 max-w-7xl mx-auto px-6 py-16">
          <div class="grid md:grid-cols-5 gap-8 items-center">
            <div class="md:col-span-2" data-aos="fade-right">
              <h2 class="text-white text-4xl md:text-5xl font-light mb-4">COYUNTURA<br>FORENSE</h2>
              <p class="text-white/80 text-base leading-relaxed mb-6">
                Análisis de las sentencias más relevantes de los tribunales chilenos. Derecho del consumidor, civil y laboral con enfoque práctico.
              </p>
              <a href="https://www.diarioconstitucional.cl/" target="_blank" rel="noopener noreferrer" class="inline-block bg-white/10 backdrop-blur-sm text-white px-6 py-3 text-sm tracking-widest uppercase hover:bg-white hover:text-primary transition-all duration-300">
                Ver más
              </a>
            </div>
            <div class="md:col-span-3 relative" data-aos="fade-left">
              <div class="border-4 border-white/20 overflow-hidden">
                <img src="/fotos/palacio-tribunales-frente.jpg" alt="Palacio de Tribunales de Justicia" class="w-full h-80 object-cover">
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="max-w-7xl mx-auto px-6 pb-16">
        <div class="grid md:grid-cols-2 gap-8">
          <div class="relative overflow-hidden" data-aos="fade-up" data-aos-delay="100">
            <div class="absolute inset-0">
              <img src="/fotos/textura-dorada.jpg" alt="" class="w-full h-full object-cover">
              <div class="absolute inset-0 bg-black/50"></div>
            </div>
            <div class="relative z-10 p-8">
              <span class="inline-block bg-white/10 backdrop-blur-sm text-white px-4 py-2 text-xs tracking-widest uppercase mb-4">DERECHO CIVIL</span>
              <p class="text-white/90 text-sm leading-relaxed mb-6">
                Teoría de la imprevisión en el derecho chileno de contratos y su impacto en la seguridad jurídica de las operaciones comerciales.
              </p>
              <div class="flex items-end gap-4">
                <a href="https://laquintasala.cl/" target="_blank" rel="noopener noreferrer" class="inline-block bg-white/10 backdrop-blur-sm text-white px-6 py-3 text-sm tracking-widest uppercase hover:bg-white hover:text-primary transition-all duration-300">
                  Ver más
                </a>
                <div class="flex-1">
                  <img src="/fotos/fachada-tribunales.jpg" alt="Fachada Tribunales de Justicia" class="w-full h-40 object-cover border-2 border-white/30">
                </div>
              </div>
            </div>
          </div>

          <div class="relative overflow-hidden" data-aos="fade-up" data-aos-delay="200">
            <div class="absolute inset-0">
              <img src="/fotos/textura-dorada.jpg" alt="" class="w-full h-full object-cover">
              <div class="absolute inset-0 bg-black/50"></div>
            </div>
            <div class="relative z-10 p-8">
              <span class="inline-block bg-white/10 backdrop-blur-sm text-white px-4 py-2 text-xs tracking-widest uppercase mb-4">DERECHO LABORAL</span>
              <p class="text-white/90 text-sm leading-relaxed mb-6">
                Nulidad del despido y diferencias en cotizaciones por semana corrida. Análisis de jurisprudencia laboral reciente.
              </p>
              <div class="flex items-end gap-4">
                <a href="https://www.portal.ijuridica.cl/" target="_blank" rel="noopener noreferrer" class="inline-block bg-white/10 backdrop-blur-sm text-white px-6 py-3 text-sm tracking-widest uppercase hover:bg-white hover:text-primary transition-all duration-300">
                  Ver más
                </a>
                <div class="flex-1">
                  <img src="/fotos/academia-judicial.jpg" alt="Academia Judicial de Chile" class="w-full h-40 object-cover border-2 border-white/30">
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Equipo -->
    <section id="equipo" class="section-padding bg-bg-light">
      <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-16" data-aos="fade-up">
          <p class="text-accent font-medium tracking-widest uppercase mb-4 text-sm">Nuestro Equipo</p>
          <h2 class="text-4xl md:text-5xl mb-4 font-light">Equipo de Abogados</h2>
          <p class="text-text-light max-w-2xl mx-auto">
            Profesionales con trayectoria probada en el ejercicio forense, docencia universitaria y servicio público.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          <div class="card-lift bg-white p-8 text-center" data-aos="fade-up" data-aos-delay="0">
            <div class="w-48 h-48 mx-auto mb-6 overflow-hidden">
              <img src="/fotos/rafael-perez.jpg" alt="Rafael Pérez Maldonado" class="w-full h-full object-cover grayscale">
            </div>
            <h3 class="text-xl mb-1">Rafael Pérez Maldonado</h3>
            <p class="text-accent text-sm font-medium mb-3">Socio Fundador</p>
            <p class="text-text-light text-sm leading-relaxed">
              Abogado y Magíster en Derecho Público y Litigación Constitucional. Más de 15 años de trayectoria profesional en litigación en materias penales, civiles y constitucionales, asesoría a instituciones públicas, tramitación legislativa y controversias patrimoniales complejas.
            </p>
          </div>

          <div class="card-lift bg-white p-8 text-center" data-aos="fade-up" data-aos-delay="100">
            <div class="w-48 h-48 mx-auto mb-6 overflow-hidden">
              <img src="/fotos/yerko-scheihing.jpg" alt="Yerko Scheihing Sepúlveda" class="w-full h-full object-cover grayscale">
            </div>
            <h3 class="text-xl mb-1">Yerko Scheihing Sepúlveda</h3>
            <p class="text-accent text-sm font-medium mb-3">Abogado Asociado</p>
            <p class="text-text-light text-sm leading-relaxed">Litigación de alta complejidad en delitos económicos, patrimoniales, tributarios, contra la indemnidad sexual y Derechos Humanos.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Contacto -->
    <section id="contacto" class="section-padding bg-white">
      <div class="max-w-6xl mx-auto px-4">
        <div class="grid md:grid-cols-2 gap-12">
          <div data-aos="fade-right">
            <p class="text-accent font-medium tracking-widest uppercase mb-4 text-sm">Atención Personalizada</p>
            <h2 class="text-4xl md:text-5xl mb-6 font-light">Contacto y Ubicación</h2>
            <p class="text-text-light mb-8">
              Estudio jurídico ubicado en el
