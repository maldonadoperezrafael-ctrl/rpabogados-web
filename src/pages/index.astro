    <!-- Motor de Despliegues Dinámicos -->
    <script is:inline>
      (function () {
        var areas = [
          {
            slug: 'danos-litigacion-civil',
            title: 'Derecho de daños y litigación civil',
            short: 'Daños y civil',
            description: 'Estrategia y representación en conflictos donde la evidencia, la cuantificación del daño y la lectura del riesgo exigen una preparación rigurosa.',
            matters: ['Responsabilidad civil', 'Indemnización de daños', 'Litigación de alta complejidad'],
            image: '/fotos/area-civil.webp',
            imageWidth: 1400,
            imageHeight: 935
          },
          {
            slug: 'penal-economico',
            title: 'Penal económico',
            short: 'Penal económico',
            description: 'Defensa y representación en materias penales de relevancia económica, con una estrategia construida desde los antecedentes y el contexto de cada caso.',
            matters: ['Defensa penal', 'Querellas', 'Asesoría a empresas'],
            image: '/fotos/area-penal.webp',
            imageWidth: 600,
            imageHeight: 439
          },
          {
            slug: 'derecho-publico',
            title: 'Derecho público',
            short: 'Derecho público',
            description: 'Litigación y asesoría frente a actuaciones de la Administración, con especial atención a la estrategia procesal y a los derechos involucrados.',
            matters: ['Contencioso-administrativo', 'Actuaciones administrativas', 'Litigación pública'],
            image: '/fotos/area-publico.webp',
            imageWidth: 720,
            imageHeight: 420
          },
          {
            slug: 'litigacion-laboral',
            title: 'Litigación laboral',
            short: 'Litigación laboral',
            description: 'Representación en conflictos laborales que requieren combinar conocimiento técnico, preparación probatoria y una mirada práctica del conflicto.',
            matters: ['Litigios laborales', 'Estrategia probatoria', 'Asesoría en conflictos'],
            image: '/fotos/area-laboral.webp',
            imageWidth: 900,
            imageHeight: 592
          }
        ];

        var activeArea = 0;
        var areaListEl = document.getElementById('area-accordion-list');
        var areaImgEl = document.getElementById('active-area-img');
        var areaNumEl = document.getElementById('active-area-num');
        var areaShortEl = document.getElementById('active-area-short');

        function renderAreas() {
          if (!areaListEl) return;
          var current = areas[activeArea];
          if (areaImgEl) {
            areaImgEl.src = current.image;
            areaImgEl.onerror = function () {
              this.onerror = null;
              this.src = 'https://2zlfjfqwo2nyc.kimi.pro' + current.image;
            };
            areaImgEl.alt = 'Imagen editorial del área de ' + current.short;
            areaImgEl.width = current.imageWidth;
            areaImgEl.height = current.imageHeight;
          }
          if (areaNumEl) areaNumEl.textContent = '0' + (activeArea + 1);
          if (areaShortEl) areaShortEl.textContent = current.short;

          areaListEl.innerHTML = areas
            .map(function (area, idx) {
              var isActive = idx === activeArea;
              var mattersHtml = area.matters
                .map(function (m) {
                  return '<li><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>' + m + '</li>';
                })
                .join('');

              return (
                '<article class="area-item ' + (isActive ? 'is-active' : '') + '">' +
