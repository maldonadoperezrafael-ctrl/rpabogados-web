---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="RP Abogados | Litigación de Alta Complejidad">
  <Header />

  <main class="pt-20">
    <!-- Hero Section Estilo Colombara -->
    <section class="relative min-h-screen flex items-end overflow-hidden">
      <!-- Imagen de fondo -->
      <div class="absolute inset-0">
        <img src="/fotos/hero-textura.jpg" alt="" class="w-full h-full object-cover">
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent"></div>
      </div>

      <!-- Contenido -->
      <div class="relative z-10 w-full max-w-7xl mx-auto px-6 pb-20">
        <div class="max-w-4xl" data-aos="fade-up">
          <h1 class="text-white text-5xl md:text-7xl lg:text-8xl font-light leading-none mb-6 tracking-tight">
            RP<br>ABOGADOS
          </h1>
          <div class="w-24 h-1 bg-accent mb-8"></div>
          <p class="text-white/90 text-lg md:text-xl font-light leading-relaxed max-w-2xl mb-8">
            Estudio jurídico con abogados altamente especializados en litigación de alta complejidad, derecho civil, penal, contencioso administrativo y laboral. Desde Santiago y la Región de O'Higgins, asesoramos a personas, empresas e instituciones en los casos más desafiantes, con un enfoque estratégico, ético y orientado a resultados.
          </p>
          <a href="#contacto" class="inline-block bg-white text-primary px-8 py-4 font-medium tracking-widest uppercase text-sm hover:bg-accent hover:text-white transition-all duration-300">
            Solicitar Consulta
          </a>
        </div>
      </div>
    </section>

    <!-- Barra de Datos -->
    <section class="bg-primary text-white py-12">
      <div class="max-w-6xl mx-auto px-4">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          <div data-aos="fade-up" data-aos-delay="0">
            <div class="text-4xl font-light text-accent mb-2">15+</div>
            <div class="text-sm text-white/70">Años de Trayectoria Jurídica y Sector Público</div>
          </div>
          <div data-aos="fade-up" data-aos-delay="100">
            <div class="text-4xl font-light text-accent mb-2">TS</div>
            <div class="text-sm text-white/70">Tribunales Superiores: Corte Suprema, Cortes de Apelaciones y Tribunal Constitucional</div>
          </div>
          <div data-aos="fade-up" data-aos-delay="200">
            <div class="text-4xl font-light text-accent mb-2">100%</div>
            <div class="text-sm text-white/70">Conducción Exclusiva por Socios</div>
          </div>
          <div data-aos="fade-up" data-aos-delay="300">
            <div class="text-4xl font-light text-accent mb-2">RM-VI</div>
            <div class="text-sm text-white/70">Región Metropolitana y VI Región de O'Higgins</div>
            <div class="text-xs text-accent/80 mt-1">Atención preferente en las Regiones</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Áreas de Práctica -->
    <section id="areas" class="section-padding bg-white">
      <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-16" data-aos="fade-up">
          <p class="text-accent font-medium tracking-widest uppercase mb-4 text-sm">Áreas de Práctica</p>
          <h2 class="text-4xl md:text-5xl mb-4 font-light">Áreas de Práctica</h2>
          <p class="text-text-light max-w-2xl mx-auto">
            Defensa y representación judicial en materias patrimoniales, penal económico, contencioso administrativo y laboral, con conducción directa de nuestros abogados en Santiago y la Región de O'Higgins.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <!-- Área 1: Civil -->
          <div class="card-lift bg-bg-light p-8" data-aos="fade-up" data-aos-delay="0">
            <div class="text-accent font-light text-5xl mb-4">01</div>
            <p class="text-accent text-sm font-medium tracking-widest uppercase mb-2">Civil & Patrimonial</p>
            <h3 class="text-2xl mb-4">Litigación Civil</h3>
            <p class="text-text-light mb-4">
              Representación especializada en juicios ordinarios y sumarios de alta cuantía ante tribunales civiles y Cortes de Apelaciones.
            </p>
            <ul class="space-y-2 text-sm text-text-light">
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">•</span>
                Particiones de herencias y divisiones de bienes entre herederos
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">•</span>
                Reclamos por ocupaciones de terrenos y daños a la propiedad
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">•</span>
                Demandas por responsabilidad contractual y extracontractual
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">•</span>
                Resolución de contratos y controversias sobre inmuebles
              </li>
            </ul>
          </div>

          <!-- Área 2: Penal -->
          <div class="card-lift bg-bg-light p-8" data-aos="fade-up" data-aos-delay="100">
            <div class="text-accent font-light text-5xl mb-4">02</div>
            <p class="text-accent text-sm font-medium tracking-widest uppercase mb-2">Penal Económico</p>
            <h3 class="text-2xl mb-4">Litigación Penal</h3>
            <p class="text-text-light mb-4">
              Defensa y querellas en litigios de alta complejidad, en todas las etapas del proceso, con estrategia y reserva absoluta.
            </p>
            <ul class="space-y-2 text-sm text-text-light">
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">•</span>
                Compliance
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">•</span>
                Presentación de querellas criminales y representación penal
              </li>
            </ul>
          </div>

          <!-- Área 3: Público -->
          <div class="card-lift bg-bg-light p-8" data-aos="fade-up" data-aos-delay="200">
            <div class="text-accent font-light text-5xl mb-4">03</div>
            <p class="text-accent text-sm font-medium tracking-widest uppercase mb-2">Público & Regulatorio</p>
            <h3 class="text-2xl mb-4">Derecho Público y Contencioso Administrativo</h3>
            <p class="text-text-light mb-4">
              Asesoría y representación en controversias con el Estado, municipalidades y organismos fiscalizadores.
            </p>
            <ul class="space-y-2 text-sm text-text-light">
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">•</span>
                Representación ante organismos públicos por procesos disciplinarios o de fiscalización
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">•</span>
                Juicios de cuentas
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">•</span>
                Acciones constitucionales
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">•</span>
                Tribunal de Contratación Pública
              </li>
            </ul>
          </div>

          <!-- Área 4: Laboral -->
          <div class="card-lift bg-bg-light p-8" data-aos="fade-up" data-aos-delay="300">
            <div class="text-accent font-light text-5xl mb-4">04</div>
            <p class="text-accent text-sm font-medium tracking-widest uppercase mb-2">Laboral</p>
            <h3 class="text-2xl mb-4">Litigación Laboral</h3>
            <p class="text-text-light mb-4">
              Defensa y representación en juicios laborales complejos, desvinculaciones de directivos y ejecutivos, y tutelas de derechos fundamentales.
            </p>
            <ul class="space-y-2 text-sm text-text-light">
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">•</span>
                Negociaciones colectivas sector público y privado
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent mt-1">•</span>
                Representación judicial trabajador y empleador
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Diferenciadores / Pilares -->
    <section class="section-padding bg-bg-light">
      <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-16" data-aos="fade-up">
          <p class="text-accent font-medium tracking-widest uppercase mb-4 text-sm">Estándar Profesional</p>
          <h2 class="text-4xl md:text-5xl mb-4 font-light">Pilares de Nuestra Práctica</h2>
          <p class="text-text-light max-w-2xl mx-auto">
            Una firma legal boutique pensada para quienes buscan excelencia técnica y atención personalizada en asuntos de alta complejidad.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center p-8" data-aos="fade-up" data-aos-delay="0">
            <div class="w-16 h-16 bg-primary text-white flex items-center justify-center mx-auto mb-6 text-2xl font-light">01</div>
            <h3 class="text-xl mb-4">Dirección Personalizada de Cada Causa</h3>
            <p class="text-text-light text-sm leading-relaxed">
              Cada asunto es conducido directamente por nuestros abogados, sin la visación de los primeros, siempre bajo la supervisión y revisión constante de todo el equipo.
            </p>
          </div>

          <div class="text-center p-8" data-aos="fade-up" data-aos-delay="100">
            <div class="w-16 h-16 bg-primary text-white flex items-center justify-center mx-auto mb-6 text-2xl font-light">02</div>
            <h3 class="text-xl mb-4">Fundamentación y Precisión Técnica</h3>
            <p class="text-text-light text-sm leading-relaxed">
              Preparamos cada presentación con base en doctrina actualizada y jurisprudencia reciente de tribunales superiores, construyendo argumentos sólidos y verificables para cada caso.
            </p>
          </div>

          <div class="text-center p-8" data-aos="fade-up" data-aos-delay="200">
            <div class="w-16 h-16 bg-primary text-white flex items-center justify-center mx-auto mb-6 text-2xl font-light">03</div>
            <h3 class="text-xl mb-4">Comunicación Permanente y Confidencialidad</h3>
            <p class="text-text-light text-sm leading-relaxed">
              Mantenemos a nuestros clientes informados en tiempo real sobre cada hito procesal, brindando claridad en los escenarios y resguardo irrestricto del secreto profesional. Atención preferente en las Regiones.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Cita Doctrinal con Rotación -->
    <section class="py-24 bg-primary text-white relative overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-0 left-1/4 w-96 h-96 bg-accent rounded-full blur-3xl"></div>
      </div>
      <div class="max-w-4xl mx-auto px-4 text-center relative z-10" data-aos="fade-up">
        <svg class="w-12 h-12 mx-auto mb-8 text-accent opacity-50" viewBox="0 0 24 24" fill="currentColor">
          <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
        </svg>

        <!-- Contenedor de citas con rotación -->
        <div class="quote-container relative min-h-[200px] flex items-center justify-center">
          <!-- Cita 1: Ulpiano -->
          <div class="quote-slide absolute inset-0 flex flex-col items-center justify-center opacity-100 transition-opacity duration-1000" data-quote="0">
            <blockquote class="text-2xl md:text-3xl font-light italic leading-relaxed mb-8">
              "La justicia es la constante y perpetua voluntad de dar a cada uno su derecho"
            </blockquote>
            <cite class="text-white/60 text-sm tracking-widest uppercase">— Ulpiano (170-228), Jurista Romano</cite>
          </div>

          <!-- Cita 2: Cicerón -->
          <div class="quote-slide absolute inset-0 flex flex-col items-center justify-center opacity-0 transition-opacity duration-1000 pointer-events-none" data-quote="1">
            <blockquote class="text-2xl md:text-3xl font-light italic leading-relaxed mb-8">
              "La ciencia que se aparte de la justicia, más que ciencia, debe llamarse astucia"
            </blockquote>
            <cite class="text-white/60 text-sm tracking-widest uppercase">— Marco Tulio Cicerón (106-43 a.C.), Orador y Jurista Romano</cite>
          </div>

          <!-- Cita 3: Montesquieu -->
          <div class="quote-slide absolute inset-0 flex flex-col items-center justify-center opacity-0 transition-opacity duration-1000 pointer-events-none" data-quote="2">
            <blockquote class="text-2xl md:text-3xl font-light italic leading-relaxed mb-8">
              "Una cosa no es justa por el hecho de ser ley. Debe ser ley porque es justa"
            </blockquote>
            <cite class="text-white/60 text-sm tracking-widest uppercase">— Montesquieu (1689-1755), Filósofo y Jurista Francés</cite>
          </div>

          <!-- Cita 4: Edward Coke -->
          <div class="quote-slide absolute inset-0 flex flex-col items-center justify-center opacity-0 transition-opacity duration-1000 pointer-events-none" data-quote="3">
            <blockquote class="text-2xl md:text-3xl font-light italic leading-relaxed mb-8">
              "El rey mismo no debe estar sujeto al hombre, sino a Dios y a la ley, porque la ley lo hace rey"
            </blockquote>
            <cite class="text-white/60 text-sm tracking-widest uppercase">— Edward Coke (1552-1634), Jurista Británico</cite>
          </div>
        </div>

        <!-- Indicadores de cita -->
        <div class="flex justify-center gap-3 mt-8">
          <button class="quote-dot w-2 h-2 rounded-full bg-accent transition-all duration-300" data-target="0" aria-label="Cita 1"></button>
          <button class="quote-dot w-2 h-2 rounded-full bg-white/30 transition-all duration-300" data-target="1" aria-label="Cita 2"></button>
          <button class="quote-dot w-2 h-2 rounded-full bg-white/30 transition-all duration-300" data-target="2" aria-label="Cita 3"></button>
          <button class="quote-dot w-2 h-2 rounded-full bg-white/30 transition-all duration-300" data-target="3" aria-label="Cita 4"></button>
        </div>
      </div>
    </section>

    <script>
      // Sistema de rotación de citas
      document.addEventListener('DOMContentLoaded', () => {
        const slides = document.querySelectorAll('.quote-slide');
        const dots = document.querySelectorAll('.quote-dot');
        let currentQuote = 0;
        let quoteInterval;

        function showQuote(index) {
          // Ocultar todas
          slides.forEach((slide, i) => {
            if (i === index) {
              slide.classList.remove('opacity-0', 'pointer-events-none');
              slide.classList.add('opacity-100');
            } else {
              slide.classList.add('opacity-0', 'pointer-events-none');
              slide.classList.remove('opacity-100');
            }
          });

          // Actualizar dots
          dots.forEach((dot, i) => {
            if (i === index) {
              dot.classList.remove('bg-white/30');
              dot.classList.add('bg-accent');
            } else {
              dot.classList.add('bg-white/30');
              dot.classList.remove('bg-accent');
            }
          });

          currentQuote = index;
        }

        function nextQuote() {
          const next = (currentQuote + 1) % slides.length;
          showQuote(next);
        }

        // Auto-rotación cada 6 segundos
        function startRotation() {
          quoteInterval = setInterval(nextQuote, 6000);
        }

        function stopRotation() {
          clearInterval(quoteInterval);
        }

        // Click en dots
        dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            const target = parseInt(dot.getAttribute('data-target'));
            stopRotation();
            showQuote(target);
            startRotation();
          });
        });

        // Pausar al hover
        const container = document.querySelector('.quote-container');
        if (container) {
          container.addEventListener('mouseenter', stopRotation);
          container.addEventListener('mouseleave', startRotation);
        }

        // Iniciar rotación
        startRotation();
      });
    </script>

    <!-- Coyuntura Forense / Noticias -->
    <section id="noticias" class="section-padding bg-white">
      <div class="max-w-6xl mx-auto px-4">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12" data-aos="fade-up">
          <div>
            <p class="text-accent font-medium tracking-widest uppercase mb-4 text-sm">Coyuntura Forense</p>
            <h2 class="text-4xl md:text-5xl mb-4 font-light">Análisis Jurisprudencial Reciente</h2>
            <p class="text-text-light">Edición Quincenal • Actualización en derecho procesal y sustantivo</p>
          </div>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <article class="card-lift bg-bg-light overflow-hidden" data-aos="fade-up" data-aos-delay="0">
            <a href="https://www.diarioconstitucional.cl/2025/07/05/corte-suprema-anula-fallo-y-declara-abusiva-clausula-que-permitia-acelerar-la-deuda-por-infraccion-a-la-prohibicion-de-enajenar/" target="_blank" rel="noopener noreferrer" class="block">
              <div class="h-48 overflow-hidden">
                <img src="/fotos/corte-suprema-audiencia.jpg" alt="Corte Suprema de Chile" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500">
              </div>
              <div class="p-6">
                <p class="text-accent text-xs font-medium tracking-widest uppercase mb-2">Derecho del Consumidor</p>
                <h3 class="text-lg mb-3 leading-snug">Corte Suprema anula fallo y declara abusiva cláusula que permitía acelerar la deuda</h3>
                <p class="text-text-light text-sm mb-4">
                  El máximo tribunal invalidó sentencia que rechazó excepciones de consumidor. Rol 12146-2024, 5 de julio de 2025.
                </p>
                <span class="text-accent text-sm font-medium">Ver sentencia →</span>
              </div>
            </a>
          </article>

          <article class="card-lift bg-bg-light overflow-hidden" data-aos="fade-up" data-aos-delay="100">
            <a href="https://laquintasala.cl/" target="_blank" rel="noopener noreferrer" class="block">
              <div class="h-48 overflow-hidden">
                <img src="/fotos/corte-justicia-chile.jpg" alt="Palacio de los Tribunales de Justicia" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500">
              </div>
              <div class="p-6">
                <p class="text-accent text-xs font-medium tracking-widest uppercase mb-2">Derecho Civil</p>
                <h3 class="text-lg mb-3 leading-snug">Teoría de la imprevisión no tiene cabida en el derecho chileno de contratos</h3>
                <p class="text-text-light text-sm mb-4">
                  La CS confirmó que la imprevisión no opera en nuestro ordenamiento contractual. Sentencia 217.959-2023, 11 de marzo de 2025.
                </p>
                <span class="text-accent text-sm font-medium">Ver análisis →</span>
              </div>
            </a>
          </article>

          <article class="card-lift bg-bg-light overflow-hidden" data-aos="fade-up" data-aos-delay="200">
            <a href="https://www.portal.ijuridica.cl/2026/07/corte-de-santiago-precisa-que-corresponde-nulidad-del-despido-si-sentencia-declara-diferencias-de-remuneracionales-por-semana-corrida/" target="_blank" rel="noopener noreferrer" class="block">
              <div class="h-48 overflow-hidden">
                <img src="/fotos/corte-apelaciones-santiago.jpg" alt="Corte de Apelaciones de Santiago" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500">
              </div>
              <div class="p-6">
                <p class="text-accent text-xs font-medium tracking-widest uppercase mb-2">Derecho Laboral</p>
                <h3 class="text-lg mb-3 leading-snug">Corte de Santiago: Nulidad del despido si hay diferencias en semana corrida</h3>
                <p class="text-text-light text-sm mb-4">
                  La CA estableció que diferencias en cotizaciones por semana corrida proceden sanción de nulidad. Rol 796-2025.
                </p>
                <span class="text-accent text-sm font-medium">Ver noticia →</span>
              </div>
            </a>
          </article>
        </div>
      </div>
    </section>

    <!-- Equipo -->
    <section id="equipo" class="section-padding bg-bg-light">
      <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-16" data-aos="fade-up">
          <p class="text-accent font-medium tracking-widest uppercase mb-4 text-sm">Nuestro Equipo</p>
          <h2 class="text-4xl md:text-5xl mb-4 font-light">Equipo de Abogados</h2>
          <p class="text-text-light max-w-2xl mx-auto">
            Profesionales con trayectoria probada en el ejercicio forense, docencia universitaria y servicio público.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          <!-- Socio 1 -->
          <div class="card-lift bg-white p-8" data-aos="fade-up" data-aos-delay="0">
            <div class="flex items-start gap-6">
              <div class="w-24 h-24 flex-shrink-0 overflow-hidden">
                <img src="/fotos/rafael-perez.jpg" alt="Rafael Pérez Maldonado" class="w-full h-full object-cover grayscale">
              </div>
              <div>
                <h3 class="text-xl mb-1">Rafael Pérez Maldonado</h3>
                <p class="text-accent text-sm font-medium mb-3">Socio Fundador</p>
                <p class="text-text-light text-sm leading-relaxed">
                  Abogado y Magíster en Derecho Público y Litigación Constitucional. Más de 15 años de trayectoria profesional en litigación forense, asesoría a instituciones públicas, tramitación legislativa y controversias patrimoniales complejas.
                </p>
              </div>
            </div>
          </div>

          <!-- Socio 2 -->
          <div class="card-lift bg-white p-8" data-aos="fade-up" data-aos-delay="100">
            <div class="flex items-start gap-6">
              <div class="w-24 h-24 flex-shrink-0 overflow-hidden">
                <img src="/fotos/yerko-scheihing.jpg" alt="Yerko Scheihing Sepúlveda" class="w-full h-full object-cover grayscale">
              </div>
              <div>
                <h3 class="text-xl mb-1">Yerko Scheihing Sepúlveda</h3>
                <p class="text-accent text-sm font-medium mb-3">Abogado Asociado</p>
                <p class="text-text-light text-sm leading-relaxed">
                  Especialista en litigación penal económica, derecho administrativo sancionatorio y cumplimiento normativo corporativo. Litigación en audiencias de control de detención, formalización y juicios orales.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contacto -->
    <section id="contacto" class="section-padding bg-white">
      <div class="max-w-6xl mx-auto px-4">
        <div class="grid md:grid-cols-2 gap-12">
          <div data-aos="fade-right">
            <p class="text-accent font-medium tracking-widest uppercase mb-4 text-sm">Atención Personalizada</p>
            <h2 class="text-4xl md:text-5xl mb-6 font-light">Contacto y Ubicación</h2>
            <p class="text-text-light mb-8">
