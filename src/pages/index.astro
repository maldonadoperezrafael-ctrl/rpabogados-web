            backdropEl.style.display = 'flex';
            openMenuBtn.setAttribute('aria-expanded', 'true');
            document.body.style.overflow = 'hidden';
          });
          backdropEl.addEventListener('click', closeMobileMenu);
        }
        if (closeMenuBtn) closeMenuBtn.addEventListener('click', closeMobileMenu);
        document.querySelectorAll('.mobile-nav-item').forEach(function (el) {
          el.addEventListener('click', closeMobileMenu);
        });

        // 6. Envío del Formulario de Contacto
        var contactForm = document.getElementById('rp-contact-form');
        var successMsg = document.getElementById('form-success-msg');
        if (contactForm) {
          contactForm.addEventListener('submit', function (e) {
            e.preventDefault();
            var data = new FormData(contactForm);
            if (successMsg) successMsg.style.display = 'flex';
            var texto =
              'Hola RP Abogados, solicito evaluación inicial.\n' +
              'Nombre: ' + (data.get('nombre') || '') + '\n' +
              'Correo: ' + (data.get('email') || '') + '\n' +
              'Región: ' + (data.get('region') || '') + '\n' +
              'Área: ' + (data.get('area') || '') + '\n' +
              'Caso: ' + (data.get('mensaje') || '');
            window.open('https://wa.me/56985497497?text=' + encodeURIComponent(texto), '_blank');
            contactForm.reset();
          });
        }

        // 7. Presentación Inicial (brand-intro) y Animaciones [data-reveal]
        var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var introEl = document.getElementById('brand-intro');
        var skipIntroBtn = document.getElementById('skip-intro-btn');
        try {
          if (!reducedMotion && !sessionStorage.getItem('rp-brand-intro') && introEl) {
            introEl.style.display = 'flex';
            sessionStorage.setItem('rp-brand-intro', 'seen');
            setTimeout(function () { introEl.classList.add('is-leaving'); }, 950);
            setTimeout(function () { introEl.style.display = 'none'; }, 1250);
          }
        } catch (err) {}
        if (skipIntroBtn && introEl) {
          skipIntroBtn.addEventListener('click', function () {
            introEl.style.display = 'none';
          });
        }

        if (!reducedMotion && 'IntersectionObserver' in window) {
          var revealObserver = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;
                var el = entry.target;
                var delay = Number(el.getAttribute('data-delay') || 0);
                if (el.animate) {
                  el.animate(
                    [
                      { opacity: 0, transform: 'translateY(26px) scale(0.985)' },
                      { opacity: 1, transform: 'translateY(0) scale(1)' }
                    ],
                    { duration: 680, delay: delay, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'both' }
                  );
                }
                revealObserver.unobserve(el);
              });
            },
            { threshold: 0.12, rootMargin: '0px 0px -5% 0px' }
          );
          document.querySelectorAll('[data-reveal]').forEach(function (el) {
            revealObserver.observe(el);
          });
        }
      })();
    </script>
  </body>
</html>

