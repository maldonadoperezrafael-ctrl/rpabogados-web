---
// src/pages/index.astro
// Versión oficial definitiva: Identidad visual corporativa, colores originales (azul/oscuro y oro #C5A880), logo oficial, hito $300M, Radio Corporación 97.7 FM y Radar de Jurisprudencia / Actualidad (PJUD + Prensa).
---
<!doctype html>
<html lang="es-CL" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#12151b" />
    <meta name="robots" content="index, follow" />
    <meta
      name="description"
      content="Litigación estratégica de alta complejidad en materias civiles, penales económicas, públicas y laborales en la Región Metropolitana y O’Higgins."
    />
    <link rel="canonical" href="https://www.rpabogados.cl/" />

    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="RP Abogados" />
    <meta property="og:title" content="RP Abogados | Estrategia legal. Defensa con propósito." />
    <meta property="og:description" content="Litigación estratégica para personas y empresas en la Región Metropolitana y O’Higgins." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.rpabogados.cl/" />
    <meta property="og:image" content="https://www.rpabogados.cl/marca/rp-abogados-og.png" />

    <link rel="icon" type="image/png" sizes="32x32" href="https://2zlfjfqwo2nyc.kimi.pro/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://2zlfjfqwo2nyc.kimi.pro/marca/rp-abogados-simbolo-180.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=Source+Sans+3:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>RP Abogados | Litigación estratégica en Santiago y O’Higgins</title>

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LegalService",
        "name": "RP Abogados",
        "url": "https://www.rpabogados.cl/",
        "logo": "https://www.rpabogados.cl/marca/rp-abogados-logo-claro.png",
        "image": "https://www.rpabogados.cl/marca/rp-abogados-og.png",
        "description": "Litigación estratégica de alta complejidad para personas y empresas en materias civiles, penales económicas, públicas y laborales.",
        "telephone": "+56 9 8549 7497",
        "email": "contacto@rpabogados.cl",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Eliodoro Yáñez 2084, oficina 41",
          "addressLocality": "Providencia",
          "addressRegion": "Región Metropolitana",
          "addressCountry": "CL"
        },
        "areaServed": [
          { "@type": "AdministrativeArea", "name": "Región Metropolitana" },
          { "@type": "AdministrativeArea", "name": "Región de O’Higgins" }
        ],
        "knowsAbout": [
          "Derecho de daños y litigación civil",
          "Penal económico",
          "Derecho público",
          "Litigación laboral"
        ]
      }
    </script>

    <link rel="stylesheet" href="https://2zlfjfqwo2nyc.kimi.pro/assets/index-DvIUQ_nt.css" />

    <style>
      :root {
        --color-azul-corporativo: #12151b;
        --color-azul-panel: #181a1f;
        --color-oro: #C5A880;
        --color-oro-hover: #b4976e;
      }
      body {
        background-color: var(--color-azul-corporativo);
        color: #f5f2eb;
      }
      /* Cero naranja, acentos estrictamente en azul/oscuro y oro #C5A880 */
      .text-oro { color: var(--color-oro) !important; }
      .bg-oro { background-color: var(--color-oro) !important; }
      .border-oro { border-color: var(--color-oro) !important; }

      /* Tarjeta de Condena Solidaria $300 Millones */
      .rp-300m-box {
        margin: 1.5rem 0;
        padding: 1.25rem 1.5rem;
        background: rgba(197, 168, 128, 0.08);
        border-left: 4px solid var(--color-oro);
        border-top: 1px solid rgba(197, 168, 128, 0.2);
        border-right: 1px solid rgba(197, 168, 128, 0.2);
        border-bottom: 1px solid rgba(197, 168, 128, 0.2);
        border-radius: 4px;
      }
      .rp-300m-title {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--color-oro);
        margin-bottom: 0.3rem;
      }
      .rp-300m-amount {
        font-family: 'Newsreader', Georgia, serif;
        font-size: clamp(2rem, 3.5vw, 2.75rem);
        font-weight: 600;
        color: #ffffff;
        line-height: 1.1;
      }
      .rp-300m-sub {
        font-size: 0.82rem;
        color: rgba(255, 255, 255, 0.75);
        margin-top: 0.2rem;
      }

      /* Botón Radio Corporación 97.7 FM */
      .rp-radio-btn {
        background-color: var(--color-oro);
        color: #12151B;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 14px 24px;
        font-weight: 700;
        font-size: 14px;
        border-radius: 4px;
        text-decoration: none !important;
        box-shadow: 0 4px 14px rgba(0,0,0,0.4);
        transition: all 0.2s ease;
      }
      .rp-radio-btn:hover {
        background-color: var(--color-oro-hover);
        transform: translateY(-1px);
      }
      .rp-live-dot {
        position: relative;
        display: inline-flex;
        width: 10px;
        height: 10px;
        background: #ef4444;
        border-radius: 50%;
      }
      .rp-live-dot::after {
        content: '';
        position: absolute;
        inset: -4px;
        border-radius: 50%;
        background: rgba(239, 68, 68, 0.5);
        animation: rpPulse 1.5s infinite;
      }
      @keyframes rpPulse {
        75%, 100% { transform: scale(2.2); opacity: 0; }
      }
    </style>
  </head>

  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <!-- SiteHeader con Logo Oficial -->
    <header class="sticky top-0 z-50 bg-[#12151B]/95 backdrop-blur-md border-b border-white/10">
      <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
        <a href="#inicio" class="flex items-center group">
          <img
            src="/marca/rp-abogados-logo-claro.png"
            onerror="this.onerror=null;this.src='https://2zlfjfqwo2nyc.kimi.pro/marca/rp-abogados-logo-claro.png';"
            alt="RP Abogados - Ayudamos a la gente"
            class="h-10 w-auto object-contain"
            width="1600"
            height="237"
          />
        </a>

        <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-stone-300" aria-label="Navegación principal">
          <a href="#filosofia" class="hover:text-[#C5A880] transition-colors">FILOSOFÍA</a>
          <a href="#areas" class="hover:text-[#C5A880] transition-colors">ÁREAS</a>
          <a href="#metodo" class="hover:text-[#C5A880] transition-colors">MÉTODO</a>
          <a href="#socios" class="hover:text-[#C5A880] transition-colors">SOCIOS</a>
          <a href="#actualidad" class="hover:text-[#C5A880] transition-colors">ACTUALIDAD</a>
          <a href="#contacto" class="hover:text-[#C5A880] transition-colors">CONTACTO</a>
        </nav>

        <a
          href="#contacto"
          class="px-4 py-2 rounded bg-[#C5A880] hover:bg-[#b4976e] text-[#12151B] font-bold text-xs sm:text-sm transition-all"
        >
          Solicitar evaluación
        </a>
      </div>
    </header>

    <main id="contenido">
      <!-- HERO SECTION -->
      <section id="inicio" class="relative min-h-[90vh] flex items-end overflow-hidden bg-[#181a1f]">
        <div class="absolute inset-0">
          <img src="/fotos/fondo-hormigon.webp" onerror="this.onerror=null;this.src='https://2zlfjfqwo2nyc.kimi.pro/fotos/fondo-hormigon.webp';" width="1920" height="1282" fetchpriority="high" decoding="async" alt="" class="w-full h-full object-cover object-center" />
          <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/55 to-transparent"></div>
        </div>

        <div class="relative z-10 w-full max-w-7xl mx-auto px-6 pb-20 pt-24">
          <div class="max-w-3xl">
            <h1 class="font-cormorant text-white text-6xl md:text-8xl lg:text-9xl font-semibold leading-[0.9] mb-6 tracking-normal drop-shadow-[0_4px_16px_rgba(0,0,0,0.9)]">
              RP<br />ABOGADOS
            </h1>

            <div class="w-24 h-1 bg-[#C5A880] mb-8 shadow-md"></div>

            <p class="text-white/95 text-lg md:text-xl font-normal leading-relaxed max-w-2xl drop-shadow-[0_2px_10px_rgba(0,0,0,0.9)] mb-8">
              Estudio jurídico orientado en litigación de alta complejidad, en juicios de derechos de daños, en delitos penales económicos-tributarios y de alta connotación social, contencioso administrativos, acciones constitucionales, derecho migratorio y derecho laboral de la empresa colectivo e individual. Desde Santiago y la Región de O'Higgins, asesoramos a personas, empresas e instituciones en los casos más desafiantes, con un enfoque estratégico, ético y orientado a resultados.
            </p>

            <!-- Botón de acceso directo al programa radial en el Hero -->
            <div class="flex flex-wrap items-center gap-4 pt-2">
              <a href="https://www.radiocorporacionpichilemu.net/" target="_blank" rel="noopener noreferrer" class="rp-radio-btn">
                <span class="rp-live-dot" aria-hidden="true"></span>
                <span>📻 Escúchanos en Vivo: Martes y Viernes 11:30 hrs (Radio Corporación 97.7 FM)</span>
              </a>
              <a href="#presencia" class="text-white/80 hover:text-white text-sm font-semibold underline underline-offset-4">
                Ver cobertura y programa en detalle &rarr;
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- BANNER PROGRAMA RADIAL "LA LEY SIN LETRA CHICA" -->
      <section id="presencia" class="bg-[#12151B] py-12 px-6 border-t border-b border-white/20">
        <div class="max-w-6xl mx-auto">
          <div class="rounded-sm bg-[#181a1f] border border-slate-700 p-6 md:p-10 shadow-lg">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-8">
              <div class="space-y-4 max-w-2xl">
                <div style="background-color: #1e293b; border: 1px solid #C5A880; color: #C5A880; display: inline-block; padding: 4px 12px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;">
                  📻 Programa Radial • Martes y Viernes 11:30 hrs
                </div>

                <h2 class="text-2xl md:text-4xl font-bold text-white tracking-tight">
                  «¿Por qué nadie lo ha dicho antes?» <span class="text-[#C5A880]">La Ley sin Letra Chica</span>
                </h2>

                <p class="text-white/85 text-sm md:text-base leading-relaxed">
                  Sintoniza a <strong class="text-white">Rafael Pérez Maldonado</strong> junto a Germán Rojas López en <strong class="text-white">Radio Corporación Pichilemu (97.7 FM)</strong>. Todos los martes y viernes a las 11:30 hrs analizamos casos reales, defensa de terrenos, herencias, negligencias y respondemos tus consultas en directo.
                </p>
              </div>

              <div class="flex flex-col gap-3 shrink-0">
                <a href="https://www.radiocorporacionpichilemu.net/" target="_blank" rel="noopener noreferrer" class="rp-radio-btn justify-center text-center">
                  <span class="rp-live-dot" aria-hidden="true"></span>
                  <span>▶ Escuchar Señal Oficial Online</span>
                </a>

                <div class="flex items-center justify-center gap-4 text-xs pt-2 text-slate-300">
                  <a href="https://radio.garden/listen/radio-corporacion-pichilemu-97-7-fm/5txg3gi4?hl=es" target="_blank" rel="noopener noreferrer" class="hover:text-white underline">Radio Garden (Celular)</a>
                  <span class="text-white/30">•</span>
                  <a href="https://emisora.cl/corporacion-pichilemu/" target="_blank" rel="noopener noreferrer" class="hover:text-white underline">Señal Emisora.cl</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- NUESTRA FILOSOFÍA -->
      <section class="py-16 bg-slate-50 border-t border-b border-slate-200 text-slate-900" id="filosofia">
        <div class="max-w-6xl mx-auto px-6">
          <div class="text-center max-w-3xl mx-auto mb-12">
            <span class="text-xs font-bold uppercase tracking-widest text-[#C5A880] block mb-2">Principios Rectores</span>
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight">Nuestra Filosofía</h2>
            <div class="w-12 h-0.5 bg-[#C5A880] mx-auto mt-3"></div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="bg-white p-8 rounded-sm border border-slate-200 border-t-4 border-t-[#C5A880] shadow-sm">
              <span class="text-4xl font-bold text-[#C5A880] block mb-3">01</span>
              <h3 class="text-xl font-bold mb-2">Dirección Personalizada de Cada Causa</h3>
              <p class="text-slate-600 text-sm leading-relaxed">
                Conducción directa y estratégica de cada litigio a cargo de los socios de la firma, integrando análisis crítico y visión multidisciplinaria en cada etapa procesal.
              </p>
            </div>

            <div class="bg-white p-8 rounded-sm border border-slate-200 border-t-4 border-t-[#C5A880] shadow-sm">
              <span class="text-4xl font-bold text-[#C5A880] block mb-3">02</span>
              <h3 class="text-xl font-bold mb-2">Fundamentación y Precisión Técnica</h3>
              <p class="text-slate-600 text-sm leading-relaxed">
                Construcción de argumentos de alto estándar técnico sustentados en el análisis exhaustivo de legislación especializada, doctrina y jurisprudencia consolidada.
              </p>
            </div>

            <div class="bg-white p-8 rounded-sm border border-slate-200 border-t-4 border-t-[#C5A880] shadow-sm">
              <span class="text-4xl font-bold text-[#C5A880] block mb-3">03</span>
              <h3 class="text-xl font-bold mb-2">Comunicación Permanente y Confidencialidad</h3>
              <p class="text-slate-600 text-sm leading-relaxed">
                Información continua y transparente sobre los avances y escenarios de cada causa, bajo el más estricto resguardo ético y reserva profesional.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- BARRA DE DATOS -->
      <section class="bg-[#12151B] text-white py-12 border-t border-b border-white/10">
        <div class="max-w-6xl mx-auto px-6">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
            <div>
              <div class="text-3xl md:text-5xl font-light text-[#C5A880] mb-1">15+</div>
              <div class="text-xs md:text-sm text-white/70 font-medium">Años de Trayectoria Jurídica</div>
            </div>
            <div>
              <div class="text-3xl md:text-5xl font-light text-[#C5A880] mb-1">TS</div>
              <div class="text-xs md:text-sm text-white/70 font-medium">Suprema, Cortes y TC</div>
            </div>
            <div>
              <div class="text-3xl md:text-5xl font-light text-[#C5A880] mb-1">100%</div>
              <div class="text-xs md:text-sm text-white/70 font-medium">Conducción Directa de Socios</div>
            </div>
            <div>
              <div class="text-3xl md:text-5xl font-light text-[#C5A880] mb-1">RM-VI</div>
              <div class="text-xs md:text-sm text-white/70 font-medium">Santiago y Región de O'Higgins</div>
            </div>
          </div>
        </div>
      </section>

      <!-- ÁREAS DE PRÁCTICA -->
      <section id="areas" class="py-16 bg-white text-slate-900">
        <div class="text-center max-w-3xl mx-auto mb-12 px-6">
          <span class="text-xs font-bold uppercase tracking-widest text-[#C5A880] block mb-1">Especialización Jurídica</span>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight">Áreas de Práctica</h2>
          <div class="w-12 h-0.5 bg-[#C5A880] mx-auto mt-3"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4">
          <div class="relative h-[380px] overflow-hidden group cursor-pointer">
            <img src="/fotos/area-civil.webp" onerror="this.onerror=null;this.src='https://2zlfjfqwo2nyc.kimi.pro/fotos/area-civil.webp';" alt="" width="800" height="437" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
            <div class="absolute inset-0 bg-black/60 group-hover:bg-black/45 transition-all duration-500"></div>
            <div class="relative z-10 h-full flex flex-col justify-end p-6">
              <span class="text-xs font-bold uppercase tracking-widest text-[#C5A880] mb-1">01 / Civil</span>
              <h3 class="text-white text-xl font-semibold mb-2">Litigación Civil</h3>
              <div class="w-12 h-0.5 bg-[#C5A880] mb-3"></div>
              <ul class="text-white/90 text-xs space-y-1.5 opacity-95">
                <li>• Particiones de herencias y comunidades</li>
                <li>• Expropiaciones e indemnizaciones</li>
                <li>• Responsabilidad contractual y extracontractual</li>
                <li>• Controversias sobre inmuebles y bienes</li>
              </ul>
            </div>
          </div>

          <div class="relative h-[380px] overflow-hidden group cursor-pointer">
            <img src="/fotos/area-penal.webp" onerror="this.onerror=null;this.src='https://2zlfjfqwo2nyc.kimi.pro/fotos/area-penal.webp';" alt="" width="600" height="439" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
            <div class="absolute inset-0 bg-black/60 group-hover:bg-black/45 transition-all duration-500"></div>
            <div class="relative z-10 h-full flex flex-col justify-end p-6">
              <span class="text-xs font-bold uppercase tracking-widest text-[#C5A880] mb-1">02 / Penal</span>
              <h3 class="text-white text-xl font-semibold mb-2">Litigación Penal &amp; Compliance</h3>
              <div class="w-12 h-0.5 bg-[#C5A880] mb-3"></div>
              <ul class="text-white/90 text-xs space-y-1.5 opacity-95">
                <li>• Litigios penales de alta complejidad</li>
                <li>• Delitos económicos, societarios y tributarios</li>
                <li>• Querellas criminales y defensa penal</li>
                <li>• Modelos de prevención del delito (Compliance)</li>
              </ul>
            </div>
          </div>

          <div class="relative h-[380px] overflow-hidden group cursor-pointer">
            <img src="/fotos/area-publico.webp" onerror="this.onerror=null;this.src='https://2zlfjfqwo2nyc.kimi.pro/fotos/area-publico.webp';" alt="" width="720" height="420" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
            <div class="absolute inset-0 bg-black/60 group-hover:bg-black/45 transition-all duration-500"></div>
            <div class="relative z-10 h-full flex flex-col justify-end p-6">
              <span class="text-xs font-bold uppercase tracking-widest text-[#C5A880] mb-1">03 / Público</span>
              <h3 class="text-white text-xl font-semibold mb-2">Derecho Público &amp; Administrativo</h3>
              <div class="w-12 h-0.5 bg-[#C5A880] mb-3"></div>
              <ul class="text-white/90 text-xs space-y-1.5 opacity-95">
                <li>• Contencioso administrativo y sanciones</li>
                <li>• Recursos de protección y amparo</li>
                <li>• Contratación pública (ChileCompra)</li>
                <li>• Sumarios disciplinarios y régimen municipal</li>
              </ul>
            </div>
          </div>

          <div class="relative h-[380px] overflow-hidden group cursor-pointer">
            <img src="/fotos/area-laboral.webp" onerror="this.onerror=null;this.src='https://2zlfjfqwo2nyc.kimi.pro/fotos/area-laboral.webp';" alt="" width="900" height="592" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
            <div class="absolute inset-0 bg-black/60 group-hover:bg-black/45 transition-all duration-500"></div>
            <div class="relative z-10 h-full flex flex-col justify-end p-6">
              <span class="text-xs font-bold uppercase tracking-widest text-[#C5A880] mb-1">04 / Laboral</span>
              <h3 class="text-white text-xl font-semibold mb-2">Litigación Laboral</h3>
              <div class="w-12 h-0.5 bg-[#C5A880] mb-3"></div>
              <ul class="text-white/90 text-xs space-y-1.5 opacity-95">
                <li>• Juicios laborales de alta cuantía indemnizatoria</li>
                <li>• Accidentes laborales y enfermedades profesionales</li>
                <li>• Tutela laboral de derechos fundamentales</li>
                <li>• Desvinculaciones de alta dirección y ejecutivos</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- CASO DESTACADO · HITO $300 MILLONES EN PICHILEMU -->
      <section class="py-16 bg-white border-t border-slate-200 text-slate-900">
        <div class="max-w-6xl mx-auto px-6">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
            <div class="lg:col-span-7 space-y-5">
              <span class="text-xs font-bold uppercase tracking-widest text-[#C5A880] block">Caso destacado · Responsabilidad civil</span>
              <h2 class="text-3xl md:text-5xl font-bold tracking-tight">Sentencia de reparación civil en Pichilemu.</h2>
              <p class="text-slate-600 text-base leading-relaxed">
                El Juzgado de Letras de Pichilemu declaró la responsabilidad solidaria del conductor y del propietario de un vehículo por un atropello ocurrido en abril de 2023. La resolución ordenó reparar los daños derivados del fallecimiento de una mujer y de las lesiones sufridas por su hijo.
              </p>
              
              <!-- Recuadro del monto de $300 Millones exactos -->
              <div class="rp-300m-box">
                <div class="rp-300m-title">Condena solidaria obtenida por RP Abogados</div>
                <div class="rp-300m-amount">$300.000.000</div>
                <div class="rp-300m-sub">($299.622.440 · Sentencia firme del 8 de octubre de 2026)</div>
