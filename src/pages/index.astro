---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="RP Abogados | Litigación Estratégica & Derecho Público - Santiago y VI Región">
  <Header />

  <main class="pt-0">
    <!-- Hero Section: Propuesta 1 (Monumental Jurídico) -->
    <section class="relative min-h-screen flex items-end overflow-hidden bg-slate-950">
      <!-- Imagen de fondo idéntica (Textura hormigón/mineral) -->
      <div class="absolute inset-0">
        <img 
          src="/fotos/textura-pizarra.jpg?v=6" 
          alt="RP Abogados" 
          class="w-full h-full object-cover object-center filter contrast-125 brightness-90"
        />
        <!-- Velo direccional: protege el texto a la izquierda y resalta la piedra a la derecha -->
        <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/60 to-black/30"></div>
      </div>

      <!-- Contenido Hero -->
      <div class="relative z-10 w-full max-w-7xl mx-auto px-6 pb-20 pt-32">
        <div class="max-w-4xl" data-aos="fade-up">
          
          <!-- Badge Superior -->
          <div class="inline-block border border-[#C5A880]/70 bg-black/40 backdrop-blur-sm px-4 py-1.5 mb-6">
            <span class="text-xs font-bold uppercase tracking-widest text-[#C5A880]">
              Litigación Estratégica &amp; Derecho Público
            </span>
          </div>

          <!-- Título H1 Monumental -->
          <h1 class="text-white text-5xl md:text-7xl lg:text-8xl font-normal leading-none mb-6 tracking-tight font-serif">
            RP<br />ABOGADOS
          </h1>

          <!-- Línea dorada de acento -->
          <div class="w-20 h-0.5 bg-[#C5A880] mb-6"></div>

          <!-- Bajada destacada (Sin cursiva) -->
          <p class="text-white text-xl md:text-2xl font-normal leading-snug max-w-3xl mb-4 not-italic">
            Defensa letrada rigurosa en litigios de alta complejidad patrimonial y penal.
          </p>

          <!-- Párrafo readecuado y sintetizado -->
          <p class="text-slate-300 text-base md:text-lg font-light leading-relaxed max-w-2xl mb-8">
            Articulamos estrategia judicial de excelencia desde Santiago y la Región de O’Higgins en juicios indemnizatorios de alta cuantía, controversias penales económicas y régimen contencioso-administrativo, resguardando con firmeza el patrimonio de nuestros clientes.
          </p>

          <!-- Botones de Acción -->
          <div class="flex flex-wrap gap-4 items-center">
            <a 
              href="#contacto" 
              class="inline-block bg-[#C5A880] hover:bg-[#b0936b] text-slate-950 font-bold px-8 py-4 tracking-wider uppercase text-sm transition-all duration-300 shadow-lg"
            >
              Solicitar Evaluación de Causa
            </a>
            <a 
              href="https://wa.me/56985497497" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 border border-white/20 hover:border-[#25D366] text-white hover:text-[#25D366] px-6 py-4 font-medium text-sm tracking-wide transition-all duration-300 backdrop-blur-sm"
            >
              <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086.159.058 1.011.477 1.184.564.173.087.289.13.332.203.043.072.043.419-.101.824z"/></svg>
              WhatsApp Directo
            </a>
          </div>

        </div>
      </div>
    </section>

    <!-- Sección: Pilares de Nuestra Práctica -->
    <section class="py-16 bg-slate-50 border-t border-b border-slate-200" id="pilares">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <span class="text-xs font-bold uppercase tracking-widest text-[#C5A880] block mb-2">Estándar Profesional</span>
          <h2 class="text-3xl font-bold text-slate-900 tracking-tight">Pilares de Nuestra Práctica</h2>
          <div class="w-12 h-0.5 bg-[#C5A880] mx-auto mt-4"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Pilar I -->
          <div class="bg-white p-8 rounded-md border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
            <span class="text-sm font-extrabold text-[#C5A880] tracking-wider block mb-3">01</span>
            <h3 class="text-lg font-bold text-slate-900 mb-3">Dirección Personalizada de Cada Causa</h3>
            <p class="text-slate-600 text-sm leading-relaxed text-justify">
              Lideramos personalmente el desarrollo de cada caso, integrando la experiencia y el análisis crítico de todo el equipo en cada etapa del proceso.
            </p>
          </div>

          <!-- Pilar II -->
          <div class="bg-white p-8 rounded-md border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
            <span class="text-sm font-extrabold text-[#C5A880] tracking-wider block mb-3">02</span>
            <h3 class="text-lg font-bold text-slate-900 mb-3">Fundamentación y Precisión Técnica</h3>
            <p class="text-slate-600 text-sm leading-relaxed text-justify">
              Sustentamos nuestras estrategias legales sobre la base del análisis exhaustivo de la legislación especializada, la doctrina y los precedentes jurisprudenciales consolidados, construyendo argumentos rigurosos, verificables y de alto estándar técnico.
            </p>
          </div>

          <!-- Pilar III -->
          <div class="bg-white p-8 rounded-md border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
            <span class="text-sm font-extrabold text-[#C5A880] tracking-wider block mb-3">03</span>
            <h3 class="text-lg font-bold text-slate-900 mb-3">Comunicación Permanente y Confidencialidad</h3>
            <p class="text-slate-600 text-sm leading-relaxed text-justify">
              Mantenemos a nuestros clientes informados sobre el avance del proceso que llevamos junto a ellos, brindando claridad de escenarios y rigurosidad técnica para enfrentar cada etapa.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Barra de Datos -->
    <section class="bg-primary text-white py-12">
      <div class="max-w-6xl mx-auto px-4">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          <div data-aos="fade-up" data-aos-delay="0">
            <div class="text-4xl font-light text-accent mb-2">15+</div>
            <div class="text-sm text-white/70">Años de Trayectoria Jurídica y Sector Público</div>
          </div>
          <div data-aos="fade-up" data-aos-delay="100">
            <div class="text-4xl font-light text-accent mb-2">TS</div>
            <div class="text-sm text-white/70">Tribunales Superiores: Corte Suprema, Cortes de Apelaciones y Tribunal Constitucional</div>
          </div>
          <div data-aos="fade-up" data-aos-delay="200">
            <div class="text-4xl font-light text-accent mb-2">100%</div>
