---
import { AREAS, LIMITES } from '../lib/contacto';

const campo =
  'w-full px-3.5 py-2 border border-slate-300 focus:border-oro-oscuro focus:outline-none focus:ring-2 focus:ring-oro-oscuro/30 text-sm rounded-sm bg-white aria-[invalid=true]:border-red-700';
const etiqueta = 'block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1';
const error = 'hidden text-xs text-red-700 mt-1';
---

<form id="form-contacto" class="space-y-4" action="/api/contacto" method="POST">
  <div>
    <label for="nombre" class={etiqueta}>Nombre completo</label>
    <input type="text" id="nombre" name="nombre" required autocomplete="name"
      minlength={LIMITES.nombre.min} maxlength={LIMITES.nombre.max}
      aria-describedby="error-nombre" class={campo} placeholder="Ej: Francisco González" />
    <p id="error-nombre" data-error="nombre" class={error}></p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <label for="email" class={etiqueta}>Correo electrónico</label>
      <input type="email" id="email" name="email" required autocomplete="email"
        maxlength={LIMITES.email.max} aria-describedby="error-email" class={campo} placeholder="correo@ejemplo.cl" />
      <p id="error-email" data-error="email" class={error}></p>
    </div>
    <div>
      <label for="telefono" class={etiqueta}>Teléfono <span class="normal-case font-normal text-slate-500">(opcional)</span></label>
      <input type="tel" id="telefono" name="telefono" autocomplete="tel"
        maxlength={LIMITES.telefono.max} aria-describedby="error-telefono" class={campo} placeholder="+56 9 1234 5678" />
      <p id="error-telefono" data-error="telefono" class={error}></p>
    </div>
  </div>

  <div>
    <label for="area" class={etiqueta}>Área de la consulta</label>
    <select id="area" name="area" required aria-describedby="error-area" class={campo}>
      <option value="" disabled selected>Seleccione un área</option>
      {AREAS.map((a) => <option value={a.id}>{a.etiqueta}</option>)}
    </select>
    <p id="error-area" data-error="area" class={error}></p>
  </div>

  <div>
    <label for="mensaje" class={etiqueta}>Resumen del asunto</label>
    <textarea id="mensaje" name="mensaje" rows="4" required
      minlength={LIMITES.mensaje.min} maxlength={LIMITES.mensaje.max}
      aria-describedby="error-mensaje" class={`${campo} resize-y`}
      placeholder="Describa brevemente los antecedentes de su causa..."></textarea>
    <p id="error-mensaje" data-error="mensaje" class={error}></p>
  </div>

  <div>
    <label class="flex items-start gap-2 text-xs text-slate-600 leading-relaxed">
      <input type="checkbox" name="consentimiento" value="si" required aria-describedby="error-consentimiento"
        class="mt-0.5 h-4 w-4 shrink-0 accent-oro-oscuro" />
      <span>Acepto que RP Abogados use estos datos únicamente para responder mi consulta, bajo reserva profesional.</span>
    </label>
    <p id="error-consentimiento" data-error="consentimiento" class={error}></p>
  </div>

  <!-- Trampas anti-spam: un humano no ve el campo ni envía en menos de 3 segundos -->
  <div class="hidden" aria-hidden="true">
    <label>No completar este campo <input type="text" name="sitio_web" tabindex="-1" autocomplete="off" /></label>
  </div>
  <input type="hidden" name="t" value={Date.now()} />

  <button type="submit" class="w-full py-3 px-6 bg-tinta hover:bg-oro text-oro hover:text-tinta font-bold text-xs uppercase tracking-widest transition-all duration-300 rounded-sm shadow-sm disabled:opacity-60 disabled:cursor-wait">
    Enviar consulta estratégica &rarr;
  </button>

  <div id="estado-contacto" role="status" aria-live="polite" class="hidden"></div>
</form>

<script>
  import { MENSAJES, type EstadoEnvio } from '../lib/contacto';

  const form = document.getElementById('form-contacto') as HTMLFormElement | null;
  const estado = document.getElementById('estado-contacto');

  const ESTILOS: Record<EstadoEnvio, string> = {
    ok: 'border-green-700 bg-green-50 text-green-800',
    error: 'border-red-700 bg-red-50 text-red-800',
    config: 'border-amber-600 bg-amber-50 text-amber-900',
  };

  const mostrar = (tipo: EstadoEnvio, texto: string) => {
    if (!estado) return;
    estado.textContent = texto;
    estado.className = `text-sm border-l-4 px-3 py-2 rounded-sm ${ESTILOS[tipo] ?? ESTILOS.error}`;
  };

  if (form && estado) {
    const boton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const textoBoton = boton.innerHTML;

    const limpiarErrores = () => {
      form.querySelectorAll<HTMLElement>('[data-error]').forEach((p) => {
        p.textContent = '';
        p.classList.add('hidden');
        form.querySelector(`[name="${p.dataset.error}"]`)?.removeAttribute('aria-invalid');
      });
    };

    // Resultado del envío sin JavaScript (el servidor redirige con ?contacto=...)
    const previo = new URLSearchParams(location.search).get('contacto') as EstadoEnvio | null;
    if (previo && previo in MENSAJES) mostrar(previo, MENSAJES[previo]);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      limpiarErrores();
      boton.disabled = true;
      boton.textContent = 'Enviando…';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const data = (await res.json()) as { estado: EstadoEnvio; mensaje: string; errores?: Record<string, string> };
        let primero: HTMLElement | null = null;
        for (const [nombre, msg] of Object.entries(data.errores ?? {})) {
          const p = form.querySelector<HTMLElement>(`[data-error="${nombre}"]`);
          if (p) {
            p.textContent = msg;
            p.classList.remove('hidden');
          }
          const control = form.querySelector<HTMLElement>(`[name="${nombre}"]`);
          control?.setAttribute('aria-invalid', 'true');
          primero ??= control;
        }
        mostrar(data.estado, data.mensaje);
        if (data.estado === 'ok') form.reset();
        primero?.focus();
      } catch {
        mostrar('error', MENSAJES.error);
      } finally {
        boton.disabled = false;
        boton.innerHTML = textoBoton;
      }
    });
  }
</script>
