---
// src/components/Header.astro
---

<header class="fixed top-0 left-0 right-0 z-50 bg-[#12151B] border-b border-white/10 py-3 px-4 md:px-8">
  <div class="max-w-7xl mx-auto flex justify-between items-center">
    
    <!-- Lado Izquierdo: Tu logo real con el nombre exacto -->
    <a href="#inicio" class="flex items-center gap-3">
      <img 
        src="/logo-rp-abogados.png" 
        alt="RP Abogados" 
        class="h-9 md:h-10 w-auto object-contain"
      />
    </a>

    <!-- Lado Derecho: Menú de Navegación completo e intacto -->
    <div class="flex items-center gap-6">
      <nav class="hidden md:flex items-center gap-6 text-xs text-white/90 font-medium tracking-widest uppercase">
        <a href="#inicio" class="hover:text-[#C5A880] transition-colors">Inicio</a>
        <a href="#filosofia" class="hover:text-[#C5A880] transition-colors">Filosofía</a>
        <a href="#areas" class="hover:text-[#C5A880] transition-colors">Áreas</a>
        <a href="#equipo" class="hover:text-[#C5A880] transition-colors">Socios</a>
        <a href="#actualidad" class="hover:text-[#C5A880] transition-colors">Actualidad</a>
      </nav>

      <a href="#contacto" class="px-4 py-2 bg-[#C5A880] text-[#12151B] font-bold text-xs rounded-sm hover:bg-[#b5966c] transition-colors shadow-sm uppercase tracking-widest">
        Contacto
      </a>
    </div>

  </div>
</header>
