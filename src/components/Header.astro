---
// src/components/Header.astro
---

<header class="fixed top-0 left-0 right-0 z-50 bg-[#12151B] shadow-lg border-b border-white/10 py-4 px-4 md:px-8">
  <div class="max-w-7xl mx-auto flex justify-between items-center">
    
    <!-- Lado Izquierdo: Logotipo y Nombre -->
    <a href="#inicio" class="flex items-center gap-3 group">
      <img 
        src="/logo-rp.png" 
        alt="RP Abogados" 
        class="h-9 md:h-11 w-auto object-contain block"
        onerror="this.style.display='none'; document.getElementById('fallback-text').style.display='block';"
      />
      <span id="fallback-text" style="display: none;" class="text-white font-bold tracking-widest text-base uppercase">
        RP ABOGADOS
      </span>
    </a>

    <!-- Centro / Derecha: Menú completo de Secciones -->
    <div class="flex items-center gap-6">
      <nav class="flex items-center gap-4 md:gap-6 text-xs text-white font-medium tracking-widest uppercase">
        <a href="#inicio" class="hover:text-[#C5A880] transition-colors hidden sm:inline-block">Inicio</a>
        <a href="#filosofia" class="hover:text-[#C5A880] transition-colors hidden md:inline-block">Filosofía</a>
        <a href="#areas" class="hover:text-[#C5A880] transition-colors hidden md:inline-block">Áreas</a>
        <a href="#equipo" class="hover:text-[#C5A880] transition-colors">Socios</a>
        <a href="#actualidad" class="hover:text-[#C5A880] transition-colors hidden lg:inline-block">Actualidad</a>
      </nav>

      <a href="#contacto" class="px-4 py-2 bg-[#C5A880] text-[#12151B] font-bold text-xs rounded-sm hover:bg-[#b5966c] transition-colors shadow-sm uppercase tracking-widest">
        Contacto
      </a>
    </div>

  </div>
</header>
