---
// src/components/Header.astro
---

<header class="w-full fixed top-0 left-0 z-50 bg-[#12151B] border-b border-[#C5A880]/30 shadow-2xl">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    
    <!-- Lado Izquierdo: Logotipo y Marca -->
    <a href="#inicio" class="flex items-center gap-3 group">
      <img 
        src="/logo-rp.png" 
        alt="RP Abogados Logo" 
        class="h-10 w-auto object-contain"
        onerror="this.style.display='none';"
      />
      <div class="flex flex-col">
        <span class="text-white font-bold text-base tracking-wider uppercase group-hover:text-[#C5A880] transition-colors">
          RP Abogados
        </span>
        <span class="text-[#C5A880] text-[10px] tracking-widest uppercase">
          Ayudamos a la gente
        </span>
      </div>
    </a>

    <!-- Centro: Menú de Navegación Principal -->
    <nav class="hidden md:flex items-center gap-8">
      <a href="#inicio" class="text-xs font-semibold text-white/90 hover:text-[#C5A880] tracking-widest uppercase transition-colors">Inicio</a>
      <a href="#filosofia" class="text-xs font-semibold text-white/90 hover:text-[#C5A880] tracking-widest uppercase transition-colors">Filosofía</a>
      <a href="#areas" class="text-xs font-semibold text-white/90 hover:text-[#C5A880] tracking-widest uppercase transition-colors">Áreas</a>
      <a href="#equipo" class="text-xs font-semibold text-white/90 hover:text-[#C5A880] tracking-widest uppercase transition-colors">Socios</a>
      <a href="#actualidad" class="text-xs font-semibold text-white/90 hover:text-[#C5A880] tracking-widest uppercase transition-colors">Actualidad</a>
    </nav>

    <!-- Lado Derecho: Botón de Contacto -->
    <div>
      <a 
        href="#contacto" 
        class="inline-block bg-[#C5A880] hover:bg-[#b5966c] text-[#12151B] font-bold text-xs px-5 py-2.5 rounded-sm uppercase tracking-widest shadow-md transition-all duration-300"
      >
        Contacto
      </a>
    </div>

  </div>
</header>
