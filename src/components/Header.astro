  <div class="bar-container">
    <div class="bar-left">
      <span class="office-location">Calle Eliodoro Yáñez 2084, Of. 41, Providencia, Santiago &bull; Región de O'Higgins</span>
    </div>
    <div class="bar-right">
      <span class="office-time">Lun - Vie: 09:00 a 19:00 hrs</span>
      <span class="bar-sep">&bull;</span>
      <a href="https://wa.me/56985497497" target="_blank" rel="noopener" class="bar-link">
        <svg class="icon-inline" width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 0 0-1.01.24l-2.2 2.2a15.053 15.053 0 0 1-6.59-6.59l2.2-2.21a.96.96 0 0 0 .25-1.01A11.36 11.36 0 0 1 8.5 3.92c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1 0 9.39 7.61 17 17 17 .55 0 1-.45 1-1v-3.54c0-.54-.45-.99-.99-.99z"/></svg>
        +56 9 8549 7497
      </a>
      <span class="bar-sep">&bull;</span>
      <a href="mailto:contacto@rpabogados.cl" class="bar-link">
        <svg class="icon-inline" width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
        contacto@rpabogados.cl
      </a>
    </div>
  </div>
</div>

<!-- CABECERA PRINCIPAL CON LOGO Y NAVEGACIÓN -->
<header class="navbar-wrapper">
  <div class="nav-container">
    
    <!-- Logo Oficial RP Abogados con Lema -->
    <a href="#inicio" class="brand-link" aria-label="RP Abogados Inicio">
      <img 
        src="/logo_dark.png" 
        alt="RP Abogados - Ayudamos a la gente" 
        class="brand-logo"
        onerror="if(this.src.indexOf('/fotos/')===-1){this.src='/fotos/logo_dark.png';}"
      />
    </a>

    <!-- Menú Escritorio -->
    <nav class="desktop-menu">
      <a href="#inicio" class="nav-link">Inicio</a>
      <a href="#filosofia" class="nav-link">Pilares</a>
      
      <!-- Desplegable Áreas de Práctica -->
      <div class="dropdown-wrap">
        <a href="#areas" class="nav-link dropdown-head">
          Áreas de Práctica <span class="arrow-glyph">&#9662;</span>
        </a>
        <div class="dropdown-box">
          <a href="#areas" class="dropdown-item">Litigación Civil &amp; Patrimonial</a>
          <a href="#areas" class="dropdown-item">Litigación Penal &amp; Compliance</a>
          <a href="#areas" class="dropdown-item">Derecho Público &amp; Administrativo</a>
          <a href="#areas" class="dropdown-item">Litigación Laboral Estratégica</a>
        </div>
      </div>

      <!-- Desplegable Socios -->
      <div class="dropdown-wrap">
        <a href="#equipo" class="nav-link dropdown-head">
          Socios <span class="arrow-glyph">&#9662;</span>
        </a>
        <div class="dropdown-box">
          <a href="#equipo" class="dropdown-item">Rafael Pérez Maldonado</a>
          <a href="#equipo" class="dropdown-item">Yerko Scheihing Sepúlveda</a>
        </div>
      </div>

      <a href="#actualidad" class="nav-link">Actualidad</a>
      <a href="#contacto" class="btn-contacto-header">Contacto</a>
    </nav>

    <!-- Botón Hamburguesa Móvil -->
    <button id="menuHamburgerBtn" class="hamburger-trigger" type="button" aria-label="Abrir Menú">
      <span class="ham-line"></span>
      <span class="ham-line"></span>
      <span class="ham-line"></span>
    </button>

  </div>

  <!-- Panel Desplegable Móvil (Oculto 100% en Escritorio) -->
  <div id="mobileDrawerMenu" class="mobile-drawer-box">
    <div class="mobile-drawer-inner">
      <a href="#inicio" class="mob-link">Inicio</a>
      <a href="#filosofia" class="mob-link">Pilares</a>
      
      <div class="mob-title">Áreas de Práctica</div>
      <div class="mob-subgroup">
        <a href="#areas" class="mob-sublink">&bull; Litigación Civil &amp; Patrimonial</a>
        <a href="#areas" class="mob-sublink">&bull; Litigación Penal &amp; Compliance</a>
        <a href="#areas" class="mob-sublink">&bull; Derecho Público &amp; Administrativo</a>
        <a href="#areas" class="mob-sublink">&bull; Litigación Laboral Estratégica</a>
      </div>

      <div class="mob-title">Socios del Estudio</div>
      <div class="mob-subgroup">
        <a href="#equipo" class="mob-sublink">&bull; Rafael Pérez Maldonado</a>
        <a href="#equipo" class="mob-sublink">&bull; Yerko Scheihing Sepúlveda</a>
      </div>

      <a href="#actualidad" class="mob-link">Actualidad Jurídica</a>
      <a href="#contacto" class="mob-btn-action">Contacto Directo</a>
      
      <div class="mob-extra-info">
        <p>Eliodoro Yáñez 2084, Of. 41, Providencia</p>
        <p>Tel: +56 9 8549 7497 &bull; contacto@rpabogados.cl</p>
      </div>
    </div>
  </div>
</header>

<style>
  .top-office-bar, .navbar-wrapper {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }

  .top-office-bar {
    background-color: #12151B;
    color: #CBD5E1;
    font-size: 11.5px;
    font-weight: 400;
    line-height: 1.4;
    border-bottom: 1px solid #1E293B;
    position: relative;
    z-index: 60;
  }

  .bar-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 8px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .bar-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .office-location {
    color: #E2E8F0;
    font-size: 11.5px;
    letter-spacing: 0.02em;
  }

  .bar-right {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .office-time {
    color: #94A3B8;
  }

  .bar-sep {
    color: #475569;
  }

  .bar-link {
    color: #F1F5F9;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: color 0.2s ease;
  }

  .bar-link:hover {
    color: #C5A880;
  }

  .icon-inline {
    vertical-align: middle;
  }

  .navbar-wrapper {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
  }

  .nav-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 10px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 72px;
  }

  .brand-link {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .brand-logo {
    height: 52px;
    width: auto;
    max-width: 220px;
    object-fit: contain;
    display: block;
  }

  .desktop-menu {
    display: flex;
    align-items: center;
    gap: 26px;
  }

  .nav-link {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #334155;
    text-decoration: none;
    padding: 8px 0;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: #C5A880;
  }

  .arrow-glyph {
    font-size: 9px;
    color: #94A3B8;
    transition: transform 0.2s ease;
  }

  .dropdown-wrap {
    position: relative;
    display: inline-block;
  }

  .dropdown-wrap:hover .arrow-glyph {
    transform: rotate(180deg);
    color: #C5A880;
  }

  .dropdown-box {
    display: none !important;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 250px;
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-top: 2px solid #C5A880;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
    border-radius: 0 0 3px 3px;
    padding: 8px 0;
    z-index: 100;
  }

  .dropdown-wrap:hover .dropdown-box {
    display: block !important;
  }

  .dropdown-item {
    display: block;
    padding: 9px 18px;
    font-size: 12px;
    font-weight: 500;
    color: #475569;
    text-decoration: none;
    border-bottom: 1px solid #F8FAFC;
    transition: all 0.2s ease;
  }

  .dropdown-item:last-child {
    border-bottom: none;
  }

  .dropdown-item:hover {
    background-color: #F8FAFC;
    color: #C5A880;
    padding-left: 22px;
  }

  .btn-contacto-header {
    border: 1px solid #C5A880;
    color: #C5A880;
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: 8px 18px;
    border-radius: 2px;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .btn-contacto-header:hover {
    background-color: #C5A880;
    color: #12151B;
  }

  .hamburger-trigger {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 26px;
    height: 19px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .ham-line {
    width: 100%;
    height: 2.5px;
    background-color: #12151B;
    border-radius: 2px;
  }

  .mobile-drawer-box {
    display: none !important;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background-color: #FFFFFF;
    border-bottom: 2px solid #C5A880;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.16);
    z-index: 90;
  }

  .mobile-drawer-box.is-open {
    display: block !important;
  }

  .mobile-drawer-inner {
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: 80vh;
    overflow-y: auto;
  }

  .mob-link {
    font-size: 12.5px;
    font-weight: 700;
    text-transform: uppercase;
    color: #12151B;
    text-decoration: none;
    padding: 8px 0;
    border-bottom: 1px solid #F1F5F9;
  }

  .mob-title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: #C5A880;
    margin-top: 8px;
    border-bottom: 1px solid #F1F5F9;
    padding-bottom: 4px;
  }

  .mob-subgroup {
    padding-left: 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .mob-sublink {
    font-size: 11.5px;
    color: #475569;
    text-decoration: none;
    padding: 4px 0;
  }

  .mob-btn-action {
    margin-top: 12px;
    text-align: center;
    background-color: #12151B;
    color: #FFFFFF !important;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 11px 0;
    border-radius: 2px;
    text-decoration: none;
  }

  .mob-extra-info {
    margin-top: 10px;
    text-align: center;
    font-size: 11px;
    color: #64748B;
  }

  @media (max-width: 960px) {
    .office-location { font-size: 10.5px; }
    .desktop-menu { display: none !important; }
    .hamburger-trigger { display: flex; }
  }

  @media (min-width: 961px) {
    .mobile-drawer-box { display: none !important; }
  }
</style>

<script is:inline>
  (function() {
    const btn = document.getElementById('menuHamburgerBtn');
    const drawer = document.getElementById('mobileDrawerMenu');
    if (!btn || !drawer) return;

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      drawer.classList.toggle('is-open');
    });

    drawer.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        drawer.classList.remove('is-open');
      });
    });

    document.addEventListener('click', (e) => {
      if (!drawer.contains(e.target) && !btn.contains(e.target)) {
        drawer.classList.remove('is-open');
      }
    });
  })();
</script>
