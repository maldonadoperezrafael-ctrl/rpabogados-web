---
// src/components/Header.astro
---

<header style="position: fixed; top: 0; left: 0; right: 0; z-index: 9999; background-color: #12151B; border-bottom: 1px solid rgba(255,255,255,0.1); padding: 12px 24px; box-shadow: 0 4px 10px rgba(0,0,0,0.5);">
  <div style="max-width: 1280px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; width: 100%;">
    
    <!-- Lado Izquierdo: Tu logo real con respaldo -->
    <a href="#inicio" style="display: flex; align-items: center; gap: 12px; text-decoration: none;">
      <img 
        src="/logo-rp-abogados.png" 
        alt="RP Abogados" 
        style="height: 38px; width: auto; object-fit: contain; display: block;"
        onerror="this.style.display='none'; document.getElementById('fallback-text').style.display='block';"
      />
      <span id="fallback-text" style="display: none; color: #ffffff; font-weight: bold; font-size: 15px; letter-spacing: 0.05em; text-transform: uppercase;">
        RP Abogados
      </span>
    </a>

    <!-- Centro / Lado Derecho: Menú de Navegación completo -->
    <nav style="display: flex; align-items: center; gap: 24px;">
      <a href="#inicio" style="color: rgba(255,255,255,0.9); font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; text-decoration: none;">Inicio</a>
      <a href="#filosofia" style="color: rgba(255,255,255,0.9); font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; text-decoration: none;">Filosofía</a>
      <a href="#areas" style="color: rgba(255,255,255,0.9); font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; text-decoration: none;">Áreas</a>
      <a href="#equipo" style="color: rgba(255,255,255,0.9); font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; text-decoration: none;">Socios</a>
      <a href="#actualidad" style="color: rgba(255,255,255,0.9); font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; text-decoration: none;">Actualidad</a>
    </nav>

    <!-- Botón de Contacto -->
    <div>
      <a 
        href="#contacto" 
        style="background-color: #C5A880; color: #12151B; font-weight: bold; font-size: 11px; padding: 10px 20px; border-radius: 2px; text-transform: uppercase; letter-spacing: 0.1em; text-decoration: none; display: inline-block;"
      >
        Contacto
      </a>
    </div>

  </div>
</header>
