---
// src/components/RadioBanner.astro
---

<div class="my-8 mx-auto max-w-5xl px-4">
  <div class="relative overflow-hidden rounded-2xl bg-slate-900 border border-slate-800 p-6 sm:p-8 shadow-xl">
    <!-- Efecto decorativo de luz de fondo -->
    <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-amber-500/10 blur-2xl pointer-events-none"></div>

    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
      
      <!-- Textos informativos -->
      <div class="space-y-3 max-w-2xl">
        <!-- Badge dinámico inyectado por JS -->
        <div id="live-badge" class="inline-flex items-center gap-2 rounded-full bg-slate-800 border border-slate-700 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-slate-300">
          <span class="relative flex h-2.5 w-2.5">
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-slate-500"></span>
          </span>
          Programa Radial • Martes y Viernes 11:30 hrs
        </div>

        <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
          «¿Por qué nadie lo ha dicho antes?» <span class="text-amber-400">La Ley sin Letra Chica</span>
        </h3>

        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          Sintoniza a <strong class="text-white">Rafael Pérez Maldonado</strong> junto a Germán Rojas López en <strong class="text-white">Radio Corporación Pichilemu (97.7 FM)</strong>. Casos reales, terrenos, herencias y consultorio jurídico en directo.
        </p>
      </div>

      <!-- Botones de conexión y streaming -->
      <div class="flex flex-col sm:flex-row lg:flex-col gap-3 shrink-0">
        <!-- Botón Principal con ID para cambio de estado en vivo -->
        <a 
          id="live-btn"
          href="https://www.radiocorporacionpichilemu.net/" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-5 py-3.5 text-sm transition shadow-lg shadow-amber-500/20"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5v14l11-7z"/>
          </svg>
          <span id="btn-text">Escuchar Señal Oficial Online</span>
        </a>

        <!-- Enlaces alternativos para móviles y respaldo -->
        <div class="flex items-center justify-center gap-4 text-xs pt-1">
          <a 
            href="https://radio.garden/listen/radio-corporacion-pichilemu-97-7-fm/5txg3gi4?hl=es" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-slate-400 hover:text-amber-400 underline underline-offset-4 transition"
          >
            Radio Garden (Celular)
          </a>
          <span class="text-slate-700">•</span>
          <a 
            href="https://emisora.cl/corporacion-pichilemu/" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-slate-400 hover:text-amber-400 underline underline-offset-4 transition"
          >
            Emisora.cl
          </a>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- Script inteligente de detección horaria (Chile Time / Santiago) -->
<script>
  function checkLiveStatus() {
    const now = new Date();
    const options = { timeZone: 'America/Santiago', weekday: 'short', hour: 'numeric', minute: 'numeric', hour12: false };
    const formatter = new Intl.DateTimeFormat('en-US', options);
    const parts = formatter.formatToParts(now);
    
    let weekday = '';
    let hour = 0;
    let minute = 0;

    parts.forEach(part => {
      if (part.type === 'weekday') weekday = part.value.toLowerCase();
      if (part.type === 'hour') hour = parseInt(part.value, 10);
      if (part.type === 'minute') minute = parseInt(part.value, 10);
    });

    const isBroadcastDay = (weekday.startsWith('tu') || weekday.startsWith('fr'));
    const totalMinutes = hour * 60 + minute;
    const startTime = 11 * 60 + 30; // 11:30
    const endTime = 12 * 60 + 30;   // 12:30

    const isLiveTime = isBroadcastDay && (totalMinutes >= startTime && totalMinutes <= endTime);

    const badge = document.getElementById('live-badge');
    const btn = document.getElementById('live-btn');
    const btnText = document.getElementById('btn-text');

    if (isLiveTime && badge && btn && btnText) {
      badge.className = "inline-flex items-center gap-2 rounded-full bg-red-500/10 border border-red-500/30 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-red-400";
      badge.innerHTML = `
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-red-500"></span>
        </span>
        ¡ESTAMOS AL AIRE AHORA MISMO!
      `;

      btn.className = "inline-flex items-center justify-center gap-2 rounded-xl bg-red-600 hover:bg-red-500 text-white font-bold px-5 py-3.5 text-sm transition shadow-lg shadow-red-600/30 animate-pulse";
      btnText.textContent = "🔴 Escuchar Programa en Vivo";
    }
  }

  checkLiveStatus();
</script>
